+def test_qwen4_exp_model_state_host_gather_ids_and_gates(monkeypatch, tmp_path) -> None:
+    """Pure-prefill ids come from the host mirror and equal the reference
+    hash; decode, draft, and uncovered batches fall back to lockstep."""
+    module, _ = _make_file_gather_embedding(monkeypatch, tmp_path)
+    state = object.__new__(Qwen4ExpModelState)
+    state.uses_ngram_embedding = True
+    state.ngram_context_len = 1
+    state.ngram_eos_token_id = 0
+    state.max_num_reqs = 4
+    state.file_gather_modules = [module]
+    state.gather_pipeline = object()
+    state._ple_host_tokens = None
+    state._ple_host_len = np.zeros(4, dtype=np.int64)
+
+    def add(req_index, tokens):
+        with patch.object(MambaHybridModelState, "add_request"):
+            state.add_request(req_index, SimpleNamespace(prefill_token_ids=tokens))
+
+    add(0, [7, 8, 9, 10, 11, 12])
+    add(1, [20, 21, 0, 30, 31])
+
+    def batch(*, drafts=0, prefill=(True, True), lens=(6, 5)):
+        state._ple_host_len[:2] = lens
+        return SimpleNamespace(
+            num_reqs=2,
+            has_prefill=True,
+            num_draft_tokens=drafts,
+            is_prefilling_np=np.array(prefill),
+            idx_mapping_np=np.array([0, 1]),
+            query_start_loc_np=np.array([0, 3, 6], dtype=np.int32),
+            num_computed_tokens_np=np.array([2, 0], dtype=np.int32),
+        )
+
+    host_ids = state._gather_host_ids(batch())
+    direct = module.compute_ngram_ids(
+        torch.tensor([9, 10, 11, 20, 21, 0]),
+        torch.tensor([0, 3, 6]),
+        torch.tensor([[8], [0]]),
+    )
+    assert torch.equal(host_ids[module], direct)
+    reference = _reference_ngram_ids(
+        torch.tensor([9, 10, 11, 20, 21, 0]),
+        torch.tensor([0, 3, 6]),
+        torch.tensor([[8], [0]]),
+        layer_multipliers=module.layer_multipliers,
+        ngram_heads_vocab_sizes=module.ngram_heads_vocab_sizes,
+        ngram_heads_offsets=module.ngram_heads_offsets,
+        eos_token_id=0,
+        heads_per_ngram=2,
+    )
+    assert torch.equal(direct, reference)
+
+    assert state._gather_host_ids(batch(drafts=4)) is None
+    assert state._gather_host_ids(batch(prefill=(True, False))) is None
+    assert state._gather_host_ids(batch(lens=(6, 2))) is None
+    assert state._gather_host_ids(batch(drafts=0, prefill=(False, False))) is None
+
+    # The mirror grows for longer prompts and keeps existing rows intact.
+    add(2, list(range(20_000)))
+    assert state._ple_host_tokens.shape == (4, 32_768)
+    np.testing.assert_array_equal(state._ple_host_tokens[0, :6], [7, 8, 9, 10, 11, 12])
+    assert state._ple_host_len[2] == 20_000
+
+
