+            logger.info_once(
+                "PLE gather pipeline enabled; pure-prefill staging runs on a "
+                "background thread from host-computed ids."
+            )
+        # Per-request mirror of prefill_token_ids; the fast path reads chunks
+        # and their left context from here so ngram ids need no GPU round-trip.
+        self._ple_host_tokens: np.ndarray | None = None
+        self._ple_host_len = np.zeros(self.max_num_reqs, dtype=np.int64)
+
+    def add_request(self, req_index: int, new_req_data: NewRequestData) -> None:
+        super().add_request(req_index, new_req_data)
+        if self.gather_pipeline is None:
+            return
+        tokens = new_req_data.prefill_token_ids
+        if tokens is None or req_index >= self.max_num_reqs:
+            self._ple_host_len[req_index] = 0
+            return
+        num_tokens = len(tokens)
+        host = self._ple_host_tokens
+        if host is None or host.shape[1] < num_tokens:
+            columns = 1 << max(13, (num_tokens - 1).bit_length())
+            grown = np.zeros((self.max_num_reqs, columns), dtype=np.int32)
+            if host is not None:
+                grown[:, : host.shape[1]] = host
+            self._ple_host_tokens = host = grown
+        host[req_index, :num_tokens] = tokens
+        self._ple_host_len[req_index] = num_tokens
+
+    def _gather_host_ids(self, input_batch: InputBatch) -> dict | None:
+        """Host ngram ids for a batch whose every new token is prompt-known.
+
+        Returns None for decode rows, draft tokens, rows the mirror does not
+        cover, or a missing pipeline, so staging falls back to lockstep.
+        """
+        if self.gather_pipeline is None:
+            return None
+        num_reqs = input_batch.num_reqs
+        if (
+            not input_batch.has_prefill
+            or input_batch.num_draft_tokens
+            or not bool(np.all(input_batch.is_prefilling_np[:num_reqs]))
+        ):
+            return None
+        host = self._ple_host_tokens
+        if host is None:
+            return None
+        req_indices = input_batch.idx_mapping_np[:num_reqs]
+        query_lens = np.diff(input_batch.query_start_loc_np[: num_reqs + 1])
+        computed = input_batch.num_computed_tokens_np[:num_reqs].astype(np.int64)
+        ends = computed + query_lens
+        if np.any(self._ple_host_len[req_indices] < ends):
+            return None
+        tokens = np.concatenate(
+            [
+                host[i, c : c + n]
+                for i, c, n in zip(req_indices, computed, query_lens, strict=True)
+            ]
+        )
+        context = np.full(
+            (num_reqs, self.ngram_context_len),
+            self.ngram_eos_token_id,
+            dtype=np.int32,
+        )
+        for row, (req_idx, start) in enumerate(zip(req_indices, computed, strict=True)):
+            low = max(0, start - self.ngram_context_len)
+            context[row, self.ngram_context_len - (start - low) :] = host[
+                req_idx, low:start
+            ]
+        query_start_loc = input_batch.query_start_loc_np[: num_reqs + 1]
+        return {
+            module: module.compute_ngram_ids(
+                torch.from_numpy(tokens),
+                torch.from_numpy(query_start_loc.astype(np.int64)),
+                torch.from_numpy(context),
+            )
+            for module in self.file_gather_modules
+        }
 
