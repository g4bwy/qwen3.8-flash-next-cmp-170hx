+@pytest.mark.cpu_test
+def test_gather_pipeline_lifecycle_and_cpu_fallback(monkeypatch, tmp_path) -> None:
+    """The thread starts and stops; CPU tensors take the lockstep path even
+    when a pipeline exists (capture and unit tests never race events)."""
+    from vllm.models.qwen4_exp.nvidia.ngram_embedding import (
+        _GatherPipeline,
+        stage_checkpoint_rows,
+    )
+
+    module, _ = _make_file_gather_embedding(monkeypatch, tmp_path, bind=True)
+    embedding = module.ngram_embedding
+    pipeline = _GatherPipeline()
+    try:
+        assert pipeline._thread.is_alive()
+        ids = torch.tensor([1, 2, 3])
+        qsl = torch.tensor([0, 3])
+        context = torch.full((1, 2), module.eos_token_id, dtype=torch.int32)
+        stage_checkpoint_rows([module], ids, qsl, context, pipeline=pipeline)
+        assert embedding._h2d_events == [None, None]
+        torch.testing.assert_close(
+            embedding._staging[:3],
+            embedding._host_rows[0][:3],
+        )
+    finally:
+        pipeline.stop()
+        pipeline._thread.join(timeout=5)
+    assert not pipeline._thread.is_alive()
+
+
+@pytest.mark.cpu_test
+def test_gather_pipeline_submit_handoff_without_cuda() -> None:
+    """Handoff fires even when the gather fails; the error surfaces on the
+    worker via join_step, and a failed barrier never reaches a stream."""
+    from vllm.models.qwen4_exp.nvidia.ngram_embedding import _GatherPipeline
+
+    pipeline = _GatherPipeline()
+    try:
+
+        class Boom:
+            _h2d_events = [None, None]
+
+            def _pread_slot(self, slot, num_tokens):
+                raise ValueError("gather failed")
+
+        handoff, barriers = pipeline.submit([(Boom(), 0, 1, object())])
+        handoff.wait(timeout=5)
+        assert handoff.is_set()
+        assert barriers == [None]
+        assert isinstance(pipeline.error, ValueError)
+        with pytest.raises(ValueError, match="gather failed"):
+            pipeline.join_step((handoff, barriers), object())
+    finally:
+        pipeline.stop()
+        pipeline._thread.join(timeout=5)
