--- /dev/null
+++ b/vllm/model_executor/layers/fused_moe/router/moe_fanout.py
@@ -0,0 +1,122 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Optional diagnostic: how many distinct experts one MoE step loads.
+
+Grouped expert kernels are bandwidth bound, so the bandwidth they achieve depends on
+how many distinct experts a step reads. That count has only ever been bounded from the
+measured kernel time, which cannot say whether the kernels sit at the device ceiling
+or well below it. This module measures it.
+
+Enable with `VLLM_MOE_FANOUT_PROBE=1`. Decode forwards are captured into CUDA graphs,
+so at replay no Python runs and they are invisible here apart from dummy ids at capture
+time, which are skipped. Prefill forwards do run in Python and carry many adjacent
+groups of `STEP_ROWS` tokens, which is the same quantity, the distinct experts a step
+of that many rows must read, so the estimate comes from sliding windows over them and
+any directly observable small forward is recorded as well.
+
+The hook sits in the shared router, so it counts for every MoE model. It reports
+counts only: no model geometry and no kernel timing lives here.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+SAMPLE_EVERY = 32  # forwards between measurements, so the read stays off the hot path
+MAX_ROWS = 64  # a forward this small is measured whole rather than windowed
+STEP_ROWS = 5  # 1 + num_speculative_tokens for MTP-4
+WINDOW_ROWS = 128  # prefill rows inspected per sampled forward
+SAMPLES_PER_BUCKET = 256
+
+_calls = 0
+_topk = 0
+_counts: dict[tuple[str, int], list[int]] = {}
+
+
+def reset() -> None:
+    """Forget everything recorded. Tests and repeated probes use this."""
+    global _calls, _topk
+    _calls = 0
+    _topk = 0
+    _counts.clear()
+
+
+def counts() -> dict[tuple[str, int], list[int]]:
+    """Distinct-expert counts keyed by ("direct", rows) or ("window", rows)."""
+    return _counts
+
+
+def _capturing() -> bool:
+    try:
+        return torch.cuda.is_current_stream_capturing()
+    except Exception:  # no CUDA context (CPU tests, dry runs)
+        return False
+
+
+def _report(kind: str, rows: int, samples: list[int]) -> None:
+    ordered = sorted(samples)
+    n = len(ordered)
+    logger.info(
+        "MoE fanout %s rows=%d over %d samples: distinct experts mean %.1f, p50 %d, "
+        "min %d, max %d (topk=%d, %d forwards seen)",
+        kind,
+        rows,
+        n,
+        sum(ordered) / n,
+        ordered[n // 2],
+        ordered[0],
+        ordered[-1],
+        _topk,
+        _calls,
+    )
+
+
+def _window_union(host_ids: list[list[int]], size: int) -> list[int]:
+    """Distinct ids over every sliding window of `size` consecutive rows."""
+    return [
+        len(set().union(*host_ids[start : start + size]))
+        for start in range(len(host_ids) - size + 1)
+    ]
+
+
+def record(topk_ids: torch.Tensor) -> None:
+    """Record the distinct expert count of one MoE forward.
+
+    Small forwards are counted whole. Larger ones contribute the union over every
+    window of `STEP_ROWS` adjacent rows inside the first `WINDOW_ROWS`.
+    """
+    global _calls, _topk
+    if not _calls:
+        # Startup proof: without this, an absent patch and an unset variable look
+        # identical, which is a silent no-op on both sides of a boot.
+        logger.info_once(
+            "MoE fanout probe armed: whole counts at rows<=%d, %d-row windows above, "
+            "sampling 1 forward in %d",
+            MAX_ROWS,
+            STEP_ROWS,
+            SAMPLE_EVERY,
+        )
+    _calls += 1
+    if _calls % SAMPLE_EVERY or _capturing():
+        return
+    rows, topk = int(topk_ids.shape[0]), int(topk_ids.shape[1])
+    _topk = topk
+    if rows > MAX_ROWS:
+        take = min(rows, WINDOW_ROWS)
+        host = topk_ids[:take].to("cpu", torch.int32).tolist()
+        samples = _window_union(host, STEP_ROWS)
+        kind, key_rows = "window", take
+    else:
+        samples = [int(torch.unique(topk_ids).numel())]
+        kind, key_rows = "direct", rows
+    if not samples:
+        return
+    bucket = _counts.setdefault((kind, key_rows), [])
+    bucket.extend(samples)
+    if len(bucket) >= SAMPLES_PER_BUCKET:
+        _report(kind, key_rows, bucket[:SAMPLES_PER_BUCKET])
+        del bucket[:SAMPLES_PER_BUCKET]
