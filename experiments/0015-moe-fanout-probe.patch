@@ -0,0 +1,99 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU tests for the MoE fan-out diagnostic.
+
+The probe exists to answer one question, how many distinct experts one decode step
+reads, so these hold the properties that make its numbers trustworthy: it counts the
+right thing, it derives the estimate for captured decode from adjacent prefill rows,
+it ignores forwards it cannot trust, it samples rather than watching every forward,
+and it says so at boot.
+"""
+
+import torch
+
+from vllm.model_executor.layers.fused_moe.router import moe_fanout
+
+
+def make(rows, topk, values):
+    return torch.tensor(values, dtype=torch.int32).reshape(rows, topk)
+
+
+def sample_calls(topk_ids, times=1):
+    """Advance the sampler the right number of calls to record `times` samples."""
+    for _ in range(moe_fanout.SAMPLE_EVERY * times):
+        moe_fanout.record(topk_ids)
+
+
+def setup_function() -> None:
+    moe_fanout.reset()
+
+
+def test_small_forward_is_counted_whole() -> None:
+    ids = make(3, 2, [0, 1, 1, 2, 2, 0])  # distinct ids are {0, 1, 2}
+    sample_calls(ids)
+    assert moe_fanout.counts()[("direct", 3)] == [3]
+
+
+def test_decode_sized_batch_is_counted_directly() -> None:
+    """Five rows of paired ids: values 0..24 appear twice each, so 25 distinct."""
+    ids = make(5, 10, [i // 2 for i in range(50)])
+    sample_calls(ids)
+    assert moe_fanout.counts()[("direct", 5)] == [25]
+
+
+def test_large_forward_is_windowed_not_counted_as_a_block() -> None:
+    rows, topk = 100, 10
+    ids = make(rows, topk, [r * topk + j for r in range(rows) for j in range(topk)])
+    sample_calls(ids)
+    assert list(moe_fanout.counts()) == [("window", 100)]
+    windows = moe_fanout.counts()[("window", 100)]
+    assert len(windows) == rows - moe_fanout.STEP_ROWS + 1
+    assert set(windows) == {moe_fanout.STEP_ROWS * topk}, "disjoint rows union to 50"
+
+
+def test_window_length_respects_the_cap() -> None:
+    rows = moe_fanout.WINDOW_ROWS + 64
+    ids = make(rows, 8, list(range(rows * 8)))
+    sample_calls(ids)
+    key = ("window", moe_fanout.WINDOW_ROWS)
+    assert list(moe_fanout.counts()) == [key]
+    assert len(moe_fanout.counts()[key]) == moe_fanout.WINDOW_ROWS - 4
+
+
+def test_capture_guard_blocks_measurement_entirely(monkeypatch) -> None:
+    monkeypatch.setattr(moe_fanout, "_capturing", lambda: True)
+    sample_calls(make(3, 2, [0, 1, 2, 3, 4, 5]), times=3)
+    assert moe_fanout.counts() == {}
+
+
+def test_sampling_is_one_forward_in_n() -> None:
+    ids = make(4, 2, [0, 1, 2, 3, 4, 5, 6, 7])  # 4 rows, 8 distinct ids
+    for _ in range(moe_fanout.SAMPLE_EVERY - 1):
+        moe_fanout.record(ids)
+    assert moe_fanout.counts() == {}
+    moe_fanout.record(ids)
+    assert moe_fanout.counts()[("direct", 4)] == [8]
+
+
+def test_report_fires_once_the_bucket_fills(monkeypatch) -> None:
+    logged = []
+    monkeypatch.setattr(
+        moe_fanout.logger, "info", lambda msg, *a, **k: logged.append(msg % a)
+    )
+    monkeypatch.setattr(moe_fanout, "SAMPLES_PER_BUCKET", 2)
+    ids = make(3, 2, [0, 1, 2, 3, 4, 5])  # 6 distinct ids per forward
+    sample_calls(ids, times=2)
+    assert len(logged) == 1
+    assert "direct rows=3" in logged[0] and "mean 6.0" in logged[0]
+
+
+def test_first_forward_proves_the_probe_is_live(monkeypatch) -> None:
+    """An absent patch and an unset variable must not look identical."""
+    logged = []
+    monkeypatch.setattr(
+        moe_fanout.logger, "info_once", lambda msg, *a, **k: logged.append(msg % a)
+    )
+    ids = make(3, 2, [0, 1, 2, 3, 4, 5])
+    moe_fanout.record(ids)
+    moe_fanout.record(ids)
+    assert len(logged) == 1 and "armed" in logged[0]
