+from unittest.mock import patch
 
 import pytest
 import torch
@@ -3044,3 +3045,27 @@ def test_amd_ngram_embedding_matches_reference_under_compile(
     )
     expected = loaded_weight[ngram_ids.cpu()].flatten(-2).to(device)
     torch.testing.assert_close(output.float(), expected.float(), rtol=0, atol=0)
+
+
+def test_draft_w8a8_head_defers_when_cutlass_does_not_apply() -> None:
+    """Biased or non-BF16 draft heads keep the bf16 embedding path."""
+    from vllm.model_executor.layers.vocab_parallel_embedding import (
+        UnquantizedEmbeddingMethod,
+    )
+    from vllm.models.qwen4_exp.nvidia.mtp import Qwen4ExpDraftW8A8EmbeddingMethod
+
+    seen: list[tuple] = []
+
+    def fake_apply(self, layer, x, bias=None):
+        seen.append((layer.weight.dtype, bias is not None))
+        return torch.nn.functional.linear(x, layer.weight.float(), bias)
+
+    method = Qwen4ExpDraftW8A8EmbeddingMethod()
+    x = torch.randn(2, 4)
+    with patch.object(UnquantizedEmbeddingMethod, "apply", fake_apply):
+        fp32_layer = SimpleNamespace(weight=torch.randn(8, 4))
+        method.apply(fp32_layer, x)
+        biased_layer = SimpleNamespace(weight=torch.randn(8, 4, dtype=torch.bfloat16))
+        method.apply(biased_layer, x, bias=torch.zeros(8))
+    assert seen == [(torch.float32, False), (torch.bfloat16, True)]
+    assert not hasattr(fp32_layer, "_draft_w8a8")
