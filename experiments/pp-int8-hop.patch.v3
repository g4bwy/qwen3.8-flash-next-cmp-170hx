# PP int8 handoff (v3, verified on tree replica: applies clean, byte-identical).
# At serving-tree root:  patch -p0 < pp-int8-hop.patch.v3
# Gate: export VLLM_QWEN4EXP_PP_INT8_HOP=1 on every stage (flag-off = inert).
--- vllm/models/qwen4_exp/nvidia/model.py	2026-10-16 10:45:38.218757206 +0200
+++ vllm/models/qwen4_exp/nvidia/model.py
@@ -10,6 +10,7 @@
 from transformers import Qwen4ExpConfig, Qwen4ExpTextConfig
 
 from vllm import envs
+from vllm.logger import init_logger
 from vllm.config import VllmConfig
 from vllm.distributed import get_pp_group
 from vllm.forward_context import get_forward_context, is_forward_context_available
@@ -87,6 +88,8 @@
 from .ple_layer import Qwen4ExpPLELayer
 from .qsa import Qwen4ExpQSAAttention
 
+logger = init_logger(__name__)
+
 # Transformers v5.18 renamed `qwen_sparse_attention` to `indexed_attention`
 # TODO: Delete qwen_... once Transformers 5.18.0 is the minimum required version.
 _QSA_LAYER_TYPES = ("qwen_sparse_attention", "indexed_attention")
@@ -410,6 +413,32 @@
             moe.experts.update_expert_map()
 
 
+def _pp_hop_quantize(
+    hidden: torch.Tensor, hc_count: int
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Per-token, per-stream symmetric int8 for the PP handoff.
+
+    Rows hold hc streams concatenated ([s0|s1|s2|s3]); each stream is scaled
+    independently so one outlier stream cannot flatten the others.
+    """
+    streams = hidden.reshape(hidden.shape[0], hc_count, -1)
+    scale = (
+        streams.abs().amax(dim=-1).clamp_(min=1e-6).mul_(1.0 / 127.0).float()
+    )
+    q = (streams / scale.unsqueeze(-1)).round_().clamp_(-127.0, 127.0)
+    return q.to(torch.int8).reshape(hidden.shape), scale
+
+
+def _pp_hop_dequantize(
+    q: torch.Tensor, scale: torch.Tensor, dtype: torch.dtype
+) -> torch.Tensor:
+    streams = (
+        q.reshape(q.shape[0], scale.shape[1], -1).to(torch.float32)
+        * scale.unsqueeze(-1)
+    )
+    return streams.reshape(q.shape[0], -1).to(dtype)
+
+
 class Qwen4ExpModel(nn.Module):
     hf_to_vllm_mapper = Qwen3_5Model.hf_to_vllm_mapper | _EXTRA_WEIGHTS_MAPPER
 
@@ -426,6 +455,13 @@
             vllm_config.parallel_config.use_sequence_parallel_moe
         )
         self.vocab_size = config.vocab_size
+        self._pp_int8_hop = envs.VLLM_QWEN4EXP_PP_INT8_HOP
+        self._pp_hop_dtype = vllm_config.model_config.dtype
+        if self._pp_int8_hop:
+            logger.info_once(
+                "Qwen4Exp PP int8 handoff ACTIVE (hop bytes halved; "
+                "every pipeline stage must set VLLM_QWEN4EXP_PP_INT8_HOP=1)"
+            )
         self._qsa_layer_ids = frozenset(
             layer_idx
             for layer_idx, layer_type in enumerate(config.layer_types)
@@ -500,10 +536,16 @@
         tensors = {
             "hidden_states": torch.zeros(
                 (batch_size, self.config.hidden_size * self.config.hc_count),
-                dtype=dtype,
+                dtype=torch.int8 if self._pp_int8_hop else dtype,
                 device=device,
             )
         }
+        if self._pp_int8_hop:
+            tensors["hidden_scale"] = torch.zeros(
+                (batch_size, self.config.hc_count),
+                dtype=torch.float32,
+                device=device,
+            )
         if self.config.ple_layer_ids:
             # PLE needs the raw token IDs on every pipeline stage. The model
             # runner stores input IDs as int32, so preserve that compact dtype
@@ -563,7 +605,23 @@
         else:
             if intermediate_tensors is None:
                 raise ValueError("pipeline stage requires intermediate tensors")
-            hidden_states = intermediate_tensors["hidden_states"]
+            if self._pp_int8_hop:
+                hidden_q = intermediate_tensors["hidden_states"]
+                if hidden_q.dtype != torch.int8 or (
+                    "hidden_scale" not in intermediate_tensors.tensors
+                ):
+                    raise RuntimeError(
+                        "VLLM_QWEN4EXP_PP_INT8_HOP is set on this stage but "
+                        "the received handoff is not int8+scaled: enable the "
+                        "env on EVERY pipeline stage"
+                    )
+                hidden_states = _pp_hop_dequantize(
+                    hidden_q,
+                    intermediate_tensors["hidden_scale"],
+                    self._pp_hop_dtype,
+                )
+            else:
+                hidden_states = intermediate_tensors["hidden_states"]
             if self.config.ple_layer_ids:
                 input_ids = intermediate_tensors["input_ids"]
 
@@ -632,6 +690,10 @@
                     hidden_states, block_output, injection
                 )
             intermediate = {"hidden_states": hidden_states}
+            if self._pp_int8_hop:
+                intermediate["hidden_states"], intermediate[
+                    "hidden_scale"
