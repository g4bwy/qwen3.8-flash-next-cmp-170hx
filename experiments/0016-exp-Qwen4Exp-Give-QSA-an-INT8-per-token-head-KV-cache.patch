 if TYPE_CHECKING:
-    from .qsa import Qwen4ExpQSAAttention
+    from .qsa import Qwen4ExpQSAAttention, Qwen4ExpQSAFlashAttentionImpl
 
 
 def apply_qsa_rope(
@@ -305,10 +305,16 @@ class QSAIndexer(nn.Module):
                 self.index_head_dim,
                 dtype=self.indexer_dtype,
             )
+            main_k_scale_cache: torch.Tensor | None = None
+            main_v_scale_cache: torch.Tensor | None = None
             if attn.kv_quant_mode.is_per_token_head:
-                raise NotImplementedError(
-                    "the fused QSA prepare writes one host scale for K and V, so "
-                    "it cannot fill a per-token-head quantized cache"
+                # The fused kernel quantizes each (token, head) itself, so it
+                # writes the data into the cache and the scale into the inline
+                # padding next to it. Those views are normally created by the
+                # read side, later in the same forward.
+                impl = cast("Qwen4ExpQSAFlashAttentionImpl", attn.impl)
