@@ -0,0 +1,190 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""W8A8 int8 scoring for the per-tensor FP8 dense linears of Qwen4Exp.
+
+sm_80 (CMP 170HX) has no FP8 tensor cores, so the dense FP8 linears
+(attention qkv/o, GDN projections, dense and shared MLP) end up in a bf16
+GEMM on dequantized weights. A W8A8 shootout on this box (2026-10-22,
+results.md) measures CUTLASS int8 at 1.29-1.68x over that path at M=2048
+including the per-token activation quant, and a loss below ~2M weight
+elements or K<1024.
+
+Enable with VLLM_QWEN4EXP_DENSE_W8A8=1. `enable_qwen4exp_dense_w8a8` swaps
+the quant method of the eligible layers in place; the method quantizes the
+effective bf16 weight (fp8 weight times its per-tensor scale) to
+per-output-channel int8 once, while the checkpoint tensors are still
+canonical, then scores with dynamic per-token activation quant plus
+`cutlass_scaled_mm`. Everything else keeps the FP8 path it uses today.
+"""
+
+import re
+
+import torch
+
+from vllm import _custom_ops as ops
+from vllm import envs
+from vllm.logger import init_logger
+from vllm.model_executor.layers.linear import LinearBase
+from vllm.model_executor.layers.quantization.fp8 import Fp8LinearMethod
+from vllm.model_executor.utils import is_weights_pre_processed
+from vllm.platforms import current_platform
+
+logger = init_logger(__name__)
+
+# int8 pays off only at prefill sizes; below this the deployed path stays
+# in the CUDA-graph capture range, where it must not change.
+_MIN_M = 512
+_MIN_ELEMS = 2_000_000
+_MIN_K = 1024
+# One row block per RTN pass: the fp32 intermediates are 4x the bf16 slice.
+_QUANT_BLOCK_ELEMS = 64 * 1024 * 1024
+
+# Only these GEMMs were benched. Routers (.gate, .shared_expert_gate), the
+# GDN conv1d, the QSA indexer, PLE, embeddings, and the LM head stay out.
+_ELIGIBLE_SUFFIX = re.compile(
+    r"\.(?:qkv_proj|o_proj|in_proj_qkvz|in_proj_ba|out_proj|gate_up_proj|down_proj)$"
+)
+
+
+def quantize_effective_weight_per_channel(
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    logical_widths: list[int],
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Round-to-nearest the dequantized weight to per-output-channel int8.
+
+    Args:
+        weight: Checkpoint weight in ``(N, K)`` FP8 layout.
+        weight_scale: One scale per logical shard of ``N``.
+        logical_widths: Row counts of those shards, summing to ``N``.
+
+    Returns:
+        ``(B, scale_b)`` where ``B`` is a ``(K, N)`` column-major int8 view for
+        ``cutlass_scaled_mm`` and ``scale_b`` is the ``(1, N)`` output-channel
+        scale.
+
+    """
+    n, k = weight.shape
+    scale = weight_scale.float()
+    # Mirror requantize_with_max_scale: a fused checkpoint carries one scale per
+    # logical shard, while an unfused one ships a single scale and leaves the
+    # remaining entries at their init value (see w8a8_utils.py).
+    per_shard = scale.ndim != 0 and scale[-1] > torch.finfo(torch.float8_e4m3fn).min
+    if per_shard:
+        repeats = torch.tensor(logical_widths, device=weight.device, dtype=torch.long)
+        row_scales = scale.repeat_interleave(repeats)
+        assert row_scales.shape[0] == n, f"{logical_widths} does not cover {n} rows"
+    else:
+        row_scales = scale.max().reshape(1).expand(n)
+
+    quantized = torch.empty(n, k, dtype=torch.int8, device=weight.device)
+    scales = torch.empty(n, 1, dtype=torch.float32, device=weight.device)
+    step = max(1, _QUANT_BLOCK_ELEMS // k)
+    for i in range(0, n, step):
+        block = weight[i : i + step].float()
+        block *= row_scales[i : i + step].unsqueeze(1)
+        block_scale = block.abs().amax(dim=1, keepdim=True).clamp_min(1e-8) / 127.0
+        quantized[i : i + step] = torch.round(block / block_scale).clamp_(-127, 127)
+        scales[i : i + step] = block_scale
+    return quantized.t(), scales.t().contiguous()
+
+
+class Qwen4ExpDenseW8A8Fp8LinearMethod(Fp8LinearMethod):
+    """FP8 dense linear that scores as W8A8 int8 through CUTLASS.
+
+    Only the compute changes: weights are still loaded, requantized, and kept
+    in the FP8 runtime format by the parent method, so any batch the int8 path
+    declines to serve falls back to the FP8 path this deployment uses today.
+    """
+
+    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:
+        weight = getattr(layer, "weight", None)
+        n, k = layer.output_size_per_partition, layer.input_size_per_partition
+        # The cache must be built from the canonical checkpoint tensors, since
+        # the FP8 kernel below rewrites layer.weight in place (Marlin packs it,
+        # Humming repads it). Weights that arrive already in runtime format
+        # have nothing canonical to read, so they keep the FP8 path.
+        if (
+            not is_weights_pre_processed()
+            and weight is not None
+            and weight.dtype in (torch.float8_e4m3fn, torch.float8_e5m2)
+            and weight.shape == (n, k)
+        ):
+            layer._qwen4exp_dense_w8a8 = quantize_effective_weight_per_channel(
+                weight, layer.weight_scale, layer.logical_widths
+            )
+        super().process_weights_after_loading(layer)
+
+    def apply(
+        self,
+        layer: torch.nn.Module,
+        x: torch.Tensor,
+        bias: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        cache = getattr(layer, "_qwen4exp_dense_w8a8", None)
+        if (
+            cache is not None
+            and bias is None
+            and x.dim() == 2
+            and x.shape[0] >= _MIN_M
+            and x.dtype in (torch.bfloat16, torch.float16)
+        ):
+            x_q, scale_a, _ = ops.scaled_int8_quant(
+                x.contiguous(), None, None, symmetric=True
+            )
+            return ops.cutlass_scaled_mm(x_q, cache[0], scale_a, cache[1], x.dtype)
+        return super().apply(layer, x, bias)
+
+
+def _is_eligible(layer: torch.nn.Module, method: Fp8LinearMethod) -> bool:
+    if not _ELIGIBLE_SUFFIX.search(getattr(layer, "prefix", "") or ""):
+        return False
+    # Per-tensor FP8 with dynamic activations only: block quant carries
+    # weight_scale_inv, and a calibrated input_scale would be dropped.
+    if method.block_quant or method.act_q_static:
+        return False
+    if getattr(layer, "bias", None) is not None:
+        return False
+    n = getattr(layer, "output_size_per_partition", 0)
+    k = getattr(layer, "input_size_per_partition", 0)
+    if n * k < _MIN_ELEMS or k < _MIN_K or (n % 16) or (k % 16):
+        return False
+    weight = getattr(layer, "weight", None)
+    if weight is None or weight.dim() != 2:
+        return False
+    return weight.dtype in (torch.float8_e4m3fn, torch.float8_e5m2)
+
+
+def enable_qwen4exp_dense_w8a8(module: torch.nn.Module) -> None:
+    """Swap the eligible dense linears of a Qwen4Exp module to W8A8 int8."""
+    if not envs.VLLM_QWEN4EXP_DENSE_W8A8:
+        return
+    if envs.VLLM_BATCH_INVARIANT:
+        logger.info("VLLM_QWEN4EXP_DENSE_W8A8 is ignored under batch invariant mode")
+        return
+    # The bench behind these thresholds ran on sm_80, where FP8 linears have no
+    # tensor-core path. Everywhere else the FP8 kernels are the fast ones.
+    if not current_platform.is_cuda() or not current_platform.is_device_capability(80):
+        logger.info_once(
+            "VLLM_QWEN4EXP_DENSE_W8A8 is only supported on sm_80, staying on FP8"
+        )
+        return
+
+    swapped = 0
+    for child in module.modules():
+        if not isinstance(child, LinearBase):
+            continue
+        method = child.quant_method
+        # Exact type so a layer already claimed by another Qwen4Exp method
+        # (draft W8A8 head, low-latency skinny GEMM) is left alone.
+        if type(method) is not Fp8LinearMethod or not _is_eligible(child, method):
+            continue
+        # In-place class swap keeps the FP8 kernel this method already picked,
+        # which every fallback below still needs.
+        method.__class__ = Qwen4ExpDenseW8A8Fp8LinearMethod
+        swapped += 1
+    logger.info(
+        "Dense FP8 linears scored as W8A8 int8 via CUTLASS: %d of %d layers",
+        swapped,
+        sum(isinstance(c, LinearBase) for c in module.modules()),
+    )
