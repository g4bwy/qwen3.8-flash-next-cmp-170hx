@@ -0,0 +1,330 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU tests for the opt-in Qwen4Exp dense W8A8 int8 path.
+
+No GPU is needed: CUTLASS and the int8 activation quant are patched, and the
+quant methods are built without running their FP8 kernel selection.
+"""
+
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+import torch
+
+from vllm import envs
+from vllm.model_executor.layers.quantization.fp8 import Fp8LinearMethod
+from vllm.models.qwen4_exp.nvidia import dense_w8a8
+from vllm.models.qwen4_exp.nvidia.dense_w8a8 import (
+    Qwen4ExpDenseW8A8Fp8LinearMethod,
+    enable_qwen4exp_dense_w8a8,
+    quantize_effective_weight_per_channel,
+)
+
+FP8 = torch.float8_e4m3fn
+_ELIGIBLE_PREFIX = "model.layers.3.self_attn.qkv_proj"
+
+
+def _bare_fp8_method(*, block_quant: bool = False, act_q_static: bool = False):
+    """An Fp8LinearMethod without the FP8 kernel selection of __init__."""
+    method = Fp8LinearMethod.__new__(Fp8LinearMethod)
+    method.block_quant = block_quant
+    method.act_q_static = act_q_static
+    method.keep_state = "fp8_kernel"
+    return method
+
+
+def _linear(
+    *,
+    prefix: str = _ELIGIBLE_PREFIX,
+    n: int = 4096,
+    k: int = 2048,
+    bias: torch.Tensor | None = None,
+    dtype: torch.dtype = FP8,
+    method=None,
+) -> torch.nn.Module:
+    layer = torch.nn.Module()
+    layer.prefix = prefix
+    layer.weight = torch.randn(n, k).clamp(-4, 4).to(dtype)
+    layer.weight_scale = torch.tensor([0.01, 0.02, 0.03])
+    layer.logical_widths = [n // 2, n // 4, n // 4]
+    layer.bias = bias
+    layer.output_size_per_partition = n
+    layer.input_size_per_partition = k
+    layer.quant_method = method if method is not None else _bare_fp8_method()
+    return layer
+
+
+def _holder(*layers: torch.nn.Module) -> torch.nn.Module:
+    root = torch.nn.Module()
+    root.quant_method = None
+    for i, layer in enumerate(layers):
+        root.add_module(f"layer{i}", layer)
+    return root
+
+
+def _cuda80(monkeypatch) -> None:
+    monkeypatch.setattr(
+        dense_w8a8,
+        "current_platform",
+        SimpleNamespace(
+            is_cuda=lambda: True,
+            is_device_capability=lambda capability: capability == 80,
+        ),
+    )
+
+
+@pytest.fixture
+def int8_env(monkeypatch):
+    """Env on, sm_80 assumed, LinearBase check relaxed to any object."""
+    monkeypatch.setattr(envs, "VLLM_QWEN4EXP_DENSE_W8A8", True, raising=False)
+    monkeypatch.setattr(envs, "VLLM_BATCH_INVARIANT", False, raising=False)
+    _cuda80(monkeypatch)
+    monkeypatch.setattr(dense_w8a8, "LinearBase", object)
+
+
+def test_env_off_leaves_methods_untouched(monkeypatch) -> None:
+    monkeypatch.setattr(envs, "VLLM_QWEN4EXP_DENSE_W8A8", False, raising=False)
+    monkeypatch.setattr(dense_w8a8, "LinearBase", object)
+    layer = _linear()
+    enable_qwen4exp_dense_w8a8(_holder(layer))
+    assert type(layer.quant_method) is Fp8LinearMethod
+    assert not hasattr(layer, "_qwen4exp_dense_w8a8")
+
+
+def test_eligible_layer_is_swapped_in_place(int8_env) -> None:
+    layer = _linear()
+    method = layer.quant_method
+    enable_qwen4exp_dense_w8a8(_holder(layer))
+    assert layer.quant_method is method
+    assert type(method) is Qwen4ExpDenseW8A8Fp8LinearMethod
+    # The swap keeps the already selected FP8 kernel for the fallback path.
+    assert method.keep_state == "fp8_kernel"
+
+
+@pytest.mark.parametrize(
+    "kwargs,reason",
+    [
+        ({"n": 1024, "k": 1024}, "below 2M weight elements"),
+        ({"k": 512, "n": 8192}, "skinny K"),
+        ({"n": 4095}, "unaligned N"),
+        ({"k": 2047, "n": 8192}, "unaligned K"),
+        ({"bias": torch.zeros(4096)}, "biased"),
+        ({"prefix": "model.layers.3.mlp.gate"}, "router"),
+        ({"prefix": "model.layers.3.linear_attn.conv1d"}, "conv1d"),
+        ({"prefix": "model.layers.3.self_attn.indexer.index_qk_proj"}, "indexer"),
+        ({"prefix": "model.layers.3.ple.kv_proj"}, "ple"),
+        ({"prefix": "lm_head"}, "embedding head"),
+        ({"dtype": torch.bfloat16}, "not an fp8 checkpoint tensor"),
+        ({"prefix": "model.visual.patch_embed.proj"}, "vision"),
+    ],
+)
+def test_guards_keep_the_fp8_path(int8_env, kwargs, reason) -> None:
+    layer = _linear(**kwargs)
+    assert not dense_w8a8._is_eligible(layer, layer.quant_method), reason
+    enable_qwen4exp_dense_w8a8(_holder(layer))
+    assert type(layer.quant_method) is Fp8LinearMethod, reason
+
+
+@pytest.mark.parametrize("kwargs", [{"block_quant": True}, {"act_q_static": True}])
+def test_guards_reject_other_fp8_schemes(int8_env, kwargs) -> None:
+    layer = _linear(method=_bare_fp8_method(**kwargs))
+    assert not dense_w8a8._is_eligible(layer, layer.quant_method)
+    enable_qwen4exp_dense_w8a8(_holder(layer))
+    assert type(layer.quant_method) is Fp8LinearMethod
+
+
+def test_guards_reject_other_platforms_and_batch_invariant(monkeypatch) -> None:
+    monkeypatch.setattr(envs, "VLLM_QWEN4EXP_DENSE_W8A8", True, raising=False)
+    monkeypatch.setattr(envs, "VLLM_BATCH_INVARIANT", False, raising=False)
+    monkeypatch.setattr(dense_w8a8, "LinearBase", object)
+    platforms = [
+        SimpleNamespace(is_cuda=lambda: False, is_device_capability=lambda cc: True),
+        SimpleNamespace(is_cuda=lambda: True, is_device_capability=lambda cc: False),
+    ]
+    for platform in platforms:
+        monkeypatch.setattr(dense_w8a8, "current_platform", platform)
+        layer = _linear()
+        enable_qwen4exp_dense_w8a8(_holder(layer))
+        assert type(layer.quant_method) is Fp8LinearMethod
+
+    _cuda80(monkeypatch)
+    monkeypatch.setattr(envs, "VLLM_BATCH_INVARIANT", True, raising=False)
+    layer = _linear()
+    enable_qwen4exp_dense_w8a8(_holder(layer))
+    assert type(layer.quant_method) is Fp8LinearMethod
+
+
+def _dequant(b_int8: torch.Tensor, scale_b: torch.Tensor) -> torch.Tensor:
+    return b_int8.t().float() * scale_b.t()
+
+
+def _noop_pwal(self, layer) -> None:
+    """Stand in for the FP8 kernel's weight rewrite in process_weights."""
+
+
+def test_rtn_error_stays_within_half_an_int8_step() -> None:
+    torch.manual_seed(0)
+    n, k = 320, 128
+    weight = torch.randn(n, k).clamp(-4, 4).to(FP8)
+    weight_scale = torch.tensor([0.002, 0.05])
+    logical_widths = [n // 2, n // 2]
+
+    b_int8, scale_b = quantize_effective_weight_per_channel(
+        weight, weight_scale, logical_widths
+    )
+    assert b_int8.shape == (k, n)
+    assert b_int8.stride() == (1, k), "B must be a column-major (K, N) view"
+    assert b_int8.dtype == torch.int8
+    assert scale_b.shape == (1, n) and scale_b.dtype == torch.float32
+
+    effective = weight.float() * weight_scale.repeat_interleave(
+        torch.tensor(logical_widths)
+    ).unsqueeze(1)
+    error = (_dequant(b_int8, scale_b) - effective).abs().amax(dim=1, keepdim=True)
+    # RTN is exact within half a quantization step of each output channel, up
+    # to fp32 rounding of the row magnitude (the bound is tight at a tie).
+    row_amax = effective.abs().amax(dim=1, keepdim=True)
+    assert (error <= scale_b.t() * 0.5 + row_amax * 1e-7).all()
+    assert (b_int8.t().abs() <= 127).all()
+    assert (b_int8.t().abs().amax(dim=1) == 127).all()
+    # The two shards keep their own scale instead of a shared one.
+    assert scale_b[0, : n // 2].max() < scale_b[0, n // 2 :].min()
+
+
+def test_rtn_handles_a_zero_row_without_blowing_up() -> None:
+    weight = torch.zeros(4, 8).to(FP8)
+    b_int8, scale_b = quantize_effective_weight_per_channel(
+        weight, torch.tensor([0.01]), [4]
+    )
+    assert torch.isfinite(scale_b).all()
+    assert (b_int8 == 0).all()
+
+
+def test_single_scale_checkpoint_is_not_read_as_per_shard() -> None:
+    torch.manual_seed(0)
+    n, k = 64, 32
+    weight = torch.randn(n, k).clamp(-4, 4).to(FP8)
+    weight_scale = torch.full((3,), torch.finfo(torch.float32).min)
+    weight_scale[0] = 0.01
+
+    b_int8, scale_b = quantize_effective_weight_per_channel(
+        weight, weight_scale, [n // 2, n // 4, n // 4]
+    )
+    effective = weight.float() * 0.01
+    error = (_dequant(b_int8, scale_b) - effective).abs()
+    assert (error <= scale_b.t() / 2 + 1e-9).all()
+    assert (scale_b > 0).all()
+
+
+def test_apply_uses_int8_only_for_prefill_sized_batches() -> None:
+    calls: list[tuple] = []
+    n, k = 2048, 1536
+
+    def fake_scaled_int8_quant(x, scale=None, azp=None, symmetric=True):
+        calls.append(("quant", tuple(x.shape), x.dtype, symmetric))
+        return (
+            torch.zeros(x.shape, dtype=torch.int8),
+            torch.ones(x.shape[0], 1, dtype=torch.float32),
+            None,
+        )
+
+    def fake_cutlass_scaled_mm(a, b, scale_a, scale_b, out_dtype, bias=None):
+        calls.append(
+            (
+                "gemm",
+                tuple(a.shape),
+                tuple(b.shape),
+                tuple(scale_a.shape),
+                tuple(scale_b.shape),
+                out_dtype,
+                bias,
+            )
+        )
+        return torch.zeros(a.shape[0], b.shape[1], dtype=out_dtype)
+
+    def fp8_apply(self, target, x, bias=None):
+        calls.append(("fp8", x.dim(), x.shape[0]))
+        return torch.zeros(x.reshape(-1, x.shape[-1]).shape[0], n, dtype=x.dtype)
+
+    method = Qwen4ExpDenseW8A8Fp8LinearMethod.__new__(Qwen4ExpDenseW8A8Fp8LinearMethod)
+    layer = _linear(n=n, k=k)
+    layer._qwen4exp_dense_w8a8 = (
+        torch.zeros(k, n, dtype=torch.int8),
+        torch.ones(1, n, dtype=torch.float32),
+    )
+
+    x = torch.randn(1024, k, dtype=torch.bfloat16)
+    with (
+        patch("vllm._custom_ops.scaled_int8_quant", fake_scaled_int8_quant),
+        patch("vllm._custom_ops.cutlass_scaled_mm", fake_cutlass_scaled_mm),
+        patch.object(Fp8LinearMethod, "apply", fp8_apply),
+    ):
+        out = method.apply(layer, x)
+        assert out.shape == (1024, n) and out.dtype == torch.bfloat16
+        assert calls[0] == ("quant", (1024, k), torch.bfloat16, True)
+        assert calls[1] == (
+            "gemm",
+            (1024, k),
+            (k, n),
+            (1024, 1),
+            (1, n),
+            torch.bfloat16,
+            None,
+        )
+
+        # Decode batches, 3D input, fp32 input, and a bias stay on the FP8 path.
+        calls.clear()
+        method.apply(layer, torch.randn(256, k, dtype=torch.bfloat16))
+        method.apply(layer, torch.randn(2, 512, k, dtype=torch.bfloat16))
+        method.apply(layer, x, bias=torch.zeros(n))
+        method.apply(layer, torch.randn(1024, k))
+        assert calls == [
+            ("fp8", 2, 256),
+            ("fp8", 3, 2),
+            ("fp8", 2, 1024),
+            ("fp8", 2, 1024),
+        ]
+
+
+def test_cache_is_built_before_the_fp8_kernel_rewrites_weight() -> None:
+    n, k = 128, 64
+    layer = _linear(n=n, k=k)
+    layer.logical_widths = [n // 2, n // 2]
+    layer.weight_scale = torch.tensor([0.01, 0.02])
+    seen: list[str] = []
+
+    def fake_parent_pwal(self, target):
+        # What Marlin and Humming do: rewrite the canonical fp8 weight.
+        seen.append("parent")
+        target.weight = torch.zeros(k, n, dtype=torch.int32)
+
+    method = Qwen4ExpDenseW8A8Fp8LinearMethod.__new__(Qwen4ExpDenseW8A8Fp8LinearMethod)
+    with patch.object(
+        Fp8LinearMethod, "process_weights_after_loading", fake_parent_pwal
+    ):
+        method.process_weights_after_loading(layer)
+
+    assert seen == ["parent"]
+    b_int8, scale_b = layer._qwen4exp_dense_w8a8
+    assert b_int8.shape == (k, n) and b_int8.dtype == torch.int8
+    assert scale_b.shape == (1, n)
+
+    # Weights that arrive already in runtime format build no cache.
+    runtime_layer = _linear(n=n, k=k)
+    runtime_layer.weight = torch.zeros(k, n, dtype=torch.int32)
+    with patch.object(Fp8LinearMethod, "process_weights_after_loading", _noop_pwal):
+        method.process_weights_after_loading(runtime_layer)
+    assert not hasattr(runtime_layer, "_qwen4exp_dense_w8a8")
+
+    # A pre-processed checkpoint is already in runtime layout, even when its
+    # dtype and a square shape happen to look canonical.
+    square = _linear(n=n, k=n)
+    square.logical_widths = [n // 2, n // 2]
+    square.weight_scale = torch.tensor([0.01, 0.02])
+    with (
+        patch.object(Fp8LinearMethod, "process_weights_after_loading", _noop_pwal),
+        patch.object(dense_w8a8, "is_weights_pre_processed", lambda: True),
+    ):
+        method.process_weights_after_loading(square)
+    assert not hasattr(square, "_qwen4exp_dense_w8a8")
