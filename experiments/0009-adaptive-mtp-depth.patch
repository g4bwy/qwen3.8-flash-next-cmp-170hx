+def step(ctrl: AcceptanceLengthController, mean_accepted: float, drafts: int = 10):
+    accepted = int(drafts * mean_accepted)
+    return ctrl.observe_batch(
+        num_drafts=drafts,
+        num_draft_tokens=max(drafts * 8, accepted),
+        num_accepted_tokens=accepted,
+    )
 
