+// "MxNxK;MxNxK;..." into shapes; false when a part does not read as one.
+bool parse_shapes(const char* spec, std::vector<Shape>& shapes) {
+    std::string part;
+    for (const char* p = spec;; ++p) {
+        if (*p != ';' && *p != '\0') {
+            part += *p;
+            continue;
+        }
+        Shape s{};
+        if (part.empty() || std::sscanf(part.c_str(), "%dx%dx%d", &s.m, &s.n, &s.k) != 3 || s.m <= 0 || s.n <= 0 ||
+            s.k <= 0)
+            return false;
+        shapes.push_back(s);
+        part.clear();
+        if (!*p) return !shapes.empty();
+    }
+}
