@@ -0,0 +1,292 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU tests for the opt-in Qwen4Exp dense W8A8 int8 path.
+
+No GPU is needed: CUTLASS and the int8 activation quant are patched, and
+the bf16 GEMM dispatch of the parent method is stood in for by a sentinel.
+"""
+
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+import torch
+
+from vllm import envs
+from vllm.model_executor.layers.linear import UnquantizedLinearMethod
+from vllm.models.qwen4_exp.nvidia import dense_w8a8
+from vllm.models.qwen4_exp.nvidia.dense_w8a8 import (
+    Qwen4ExpDenseW8A8LinearMethod,
+    enable_qwen4exp_dense_w8a8,
+    quantize_weight_per_channel,
+)
+
+_ELIGIBLE_PREFIX = "model.layers.3.self_attn.qkv_proj"
+
+
+def _bare_unquantized_method(cls=UnquantizedLinearMethod):
+    """An UnquantizedLinearMethod without running __init__'s GEMM dispatch."""
+    method = cls.__new__(cls)
+    method.keep_state = "bf16_gemm"
+    return method
+
+
+def _linear(
+    *,
+    prefix: str = _ELIGIBLE_PREFIX,
+    n: int = 4096,
+    k: int = 2048,
+    bias: torch.Tensor | None = None,
+    dtype: torch.dtype = torch.bfloat16,
+    method=None,
+) -> torch.nn.Module:
+    layer = torch.nn.Module()
+    layer.prefix = prefix
+    layer.weight = torch.randn(n, k).clamp(-4, 4).to(dtype)
+    layer.bias = bias
+    layer.output_size_per_partition = n
+    layer.input_size_per_partition = k
+    layer.quant_method = method if method is not None else _bare_unquantized_method()
+    return layer
+
+
+def _holder(*layers: torch.nn.Module) -> torch.nn.Module:
+    root = torch.nn.Module()
+    root.quant_method = None
+    for i, layer in enumerate(layers):
+        root.add_module(f"layer{i}", layer)
+    return root
+
+
+def _cuda80(monkeypatch) -> None:
+    monkeypatch.setattr(
+        dense_w8a8,
+        "current_platform",
+        SimpleNamespace(
+            is_cuda=lambda: True,
+            is_device_capability=lambda capability: capability == 80,
+        ),
+    )
+
+
+@pytest.fixture
+def int8_env(monkeypatch):
+    """Env on, sm_80 assumed, LinearBase check relaxed to any object."""
+    monkeypatch.setattr(envs, "VLLM_QWEN4EXP_DENSE_W8A8", True, raising=False)
+    monkeypatch.setattr(envs, "VLLM_BATCH_INVARIANT", False, raising=False)
+    _cuda80(monkeypatch)
+    monkeypatch.setattr(dense_w8a8, "LinearBase", object)
+
+
+def test_env_off_leaves_methods_untouched(monkeypatch) -> None:
+    monkeypatch.setattr(envs, "VLLM_QWEN4EXP_DENSE_W8A8", False, raising=False)
+    monkeypatch.setattr(dense_w8a8, "LinearBase", object)
+    layer = _linear()
+    enable_qwen4exp_dense_w8a8(_holder(layer))
+    assert type(layer.quant_method) is UnquantizedLinearMethod
+    assert not hasattr(layer, "_qwen4exp_dense_w8a8")
+
+
+def test_eligible_layer_is_swapped_in_place(int8_env) -> None:
+    layer = _linear()
+    method = layer.quant_method
+    enable_qwen4exp_dense_w8a8(_holder(layer))
+    assert layer.quant_method is method
+    assert type(method) is Qwen4ExpDenseW8A8LinearMethod
+    # The swap keeps the already dispatched bf16 GEMM for the fallback path.
+    assert method.keep_state == "bf16_gemm"
+
+
+@pytest.mark.parametrize(
+    "kwargs,reason",
+    [
+        ({"n": 1024, "k": 1024}, "below 2M weight elements"),
+        ({"k": 512, "n": 8192}, "skinny K"),
+        ({"n": 4095}, "unaligned N"),
+        ({"k": 2047, "n": 8192}, "unaligned K"),
+        ({"bias": torch.zeros(4096)}, "biased"),
+        ({"prefix": "model.layers.3.mlp.gate"}, "router"),
+        ({"prefix": "model.layers.3.mlp.shared_expert_gate"}, "expert gate"),
+        ({"prefix": "model.layers.3.linear_attn.in_proj_a"}, "ungated GDN proj"),
+        ({"prefix": "model.layers.3.ple.kv_proj"}, "ple"),
+        ({"prefix": "lm_head"}, "embedding head"),
+        ({"dtype": torch.float32}, "not a bf16/fp16 weight"),
+        ({"prefix": "model.visual.patch_embed.proj"}, "vision"),
+    ],
+)
+def test_guards_keep_the_bf16_path(int8_env, kwargs, reason) -> None:
+    layer = _linear(**kwargs)
+    assert not dense_w8a8._is_eligible(layer), reason
+    enable_qwen4exp_dense_w8a8(_holder(layer))
+    assert type(layer.quant_method) is UnquantizedLinearMethod, reason
+
+
+def test_subclasses_of_the_bf16_method_are_left_alone(int8_env) -> None:
+    class Claimed(UnquantizedLinearMethod):
+        pass
+
+    layer = _linear(method=_bare_unquantized_method(Claimed))
+    enable_qwen4exp_dense_w8a8(_holder(layer))
+    assert type(layer.quant_method) is Claimed
+
+
+def test_guards_reject_other_platforms_and_batch_invariant(monkeypatch) -> None:
+    monkeypatch.setattr(envs, "VLLM_QWEN4EXP_DENSE_W8A8", True, raising=False)
+    monkeypatch.setattr(envs, "VLLM_BATCH_INVARIANT", False, raising=False)
+    monkeypatch.setattr(dense_w8a8, "LinearBase", object)
+    platforms = [
+        SimpleNamespace(is_cuda=lambda: False, is_device_capability=lambda cc: True),
+        SimpleNamespace(is_cuda=lambda: True, is_device_capability=lambda cc: False),
+    ]
+    for platform in platforms:
+        monkeypatch.setattr(dense_w8a8, "current_platform", platform)
+        layer = _linear()
+        enable_qwen4exp_dense_w8a8(_holder(layer))
+        assert type(layer.quant_method) is UnquantizedLinearMethod
+
+    _cuda80(monkeypatch)
+    monkeypatch.setattr(envs, "VLLM_BATCH_INVARIANT", True, raising=False)
+    layer = _linear()
+    enable_qwen4exp_dense_w8a8(_holder(layer))
+    assert type(layer.quant_method) is UnquantizedLinearMethod
+
+
+def _dequant(b_int8: torch.Tensor, scale_b: torch.Tensor) -> torch.Tensor:
+    return b_int8.t().float() * scale_b.t()
+
+
+def test_rtn_error_stays_within_half_an_int8_step() -> None:
+    torch.manual_seed(0)
+    n, k = 320, 128
+    weight = torch.randn(n, k).clamp(-4, 4).to(torch.bfloat16)
+
+    b_int8, scale_b = quantize_weight_per_channel(weight)
+    assert b_int8.shape == (k, n)
+    assert b_int8.stride() == (1, k), "B must be a column-major (K, N) view"
+    assert b_int8.dtype == torch.int8
+    assert scale_b.shape == (1, n) and scale_b.dtype == torch.float32
+
+    effective = weight.float()
+    error = (_dequant(b_int8, scale_b) - effective).abs().amax(dim=1, keepdim=True)
+    # RTN is exact within half a quantization step of each output channel, up
+    # to fp32 rounding of the row magnitude (the bound is tight at a tie).
+    row_amax = effective.abs().amax(dim=1, keepdim=True)
+    assert (error <= scale_b.t() * 0.5 + row_amax * 1e-7).all()
+    assert (b_int8.t().abs() <= 127).all()
+    # A full row reaches the top of the int8 range.
+    assert (b_int8.t().abs().amax(dim=1) == 127).all()
+
+
+def test_rtn_handles_a_zero_row_without_blowing_up() -> None:
+    weight = torch.zeros(4, 8, dtype=torch.bfloat16)
+    b_int8, scale_b = quantize_weight_per_channel(weight)
+    assert torch.isfinite(scale_b).all()
+    assert (b_int8 == 0).all()
+
+
+def test_rtn_chunking_does_not_change_the_result(monkeypatch) -> None:
+    torch.manual_seed(0)
+    n, k = 320, 128
+    weight = torch.randn(n, k).clamp(-4, 4).to(torch.bfloat16)
+    whole = quantize_weight_per_channel(weight)
+    monkeypatch.setattr(dense_w8a8, "_QUANT_BLOCK_ELEMS", 32 * 128)
+    chunked = quantize_weight_per_channel(weight)
+    assert torch.equal(whole[0], chunked[0])
+    assert torch.equal(whole[1], chunked[1])
+
+
+def test_cache_is_built_after_loading_and_weight_is_kept() -> None:
+    n, k = 256, 128
+    layer = _linear(n=n, k=k)
+    seen: list[str] = []
+
+    def fake_parent_pwal(self, target):
+        seen.append("parent")
+
+    method = Qwen4ExpDenseW8A8LinearMethod.__new__(Qwen4ExpDenseW8A8LinearMethod)
+    with patch.object(
+        UnquantizedLinearMethod, "process_weights_after_loading", fake_parent_pwal
+    ):
+        method.process_weights_after_loading(layer)
+
+    assert seen == ["parent"]
+    b_int8, scale_b = layer._qwen4exp_dense_w8a8
+    assert b_int8.shape == (k, n) and b_int8.dtype == torch.int8
+    assert scale_b.shape == (1, n)
+    # The bf16 weight the fallback path and the captured graph use survives.
+    assert layer.weight.dtype is torch.bfloat16
+
+
+def test_apply_uses_int8_only_for_prefill_sized_batches() -> None:
+    calls: list[tuple] = []
+    n, k = 2048, 1536
+
+    def fake_scaled_int8_quant(x, scale=None, azp=None, symmetric=True):
+        calls.append(("quant", tuple(x.shape), x.dtype, symmetric))
+        return (
+            torch.zeros(x.shape, dtype=torch.int8),
+            torch.ones(x.shape[0], 1, dtype=torch.float32),
+            None,
+        )
+
+    def fake_cutlass_scaled_mm(a, b, scale_a, scale_b, out_dtype, bias=None):
+        calls.append(
+            (
+                "gemm",
+                tuple(a.shape),
+                tuple(b.shape),
+                tuple(scale_a.shape),
+                tuple(scale_b.shape),
+                out_dtype,
+                bias,
+            )
+        )
+        return torch.zeros(a.shape[0], b.shape[1], dtype=out_dtype)
+
+    def bf16_apply(self, target, x, bias=None):
+        calls.append(("bf16", x.dim(), x.shape[0]))
+        return torch.zeros(x.reshape(-1, x.shape[-1]).shape[0], n, dtype=x.dtype)
+
+    method = Qwen4ExpDenseW8A8LinearMethod.__new__(Qwen4ExpDenseW8A8LinearMethod)
+    layer = _linear(n=n, k=k)
+    layer._qwen4exp_dense_w8a8 = (
+        torch.zeros(k, n, dtype=torch.int8),
+        torch.ones(1, n, dtype=torch.float32),
+    )
+
+    x = torch.randn(1024, k, dtype=torch.bfloat16)
+    with (
+        patch("vllm._custom_ops.scaled_int8_quant", fake_scaled_int8_quant),
+        patch("vllm._custom_ops.cutlass_scaled_mm", fake_cutlass_scaled_mm),
+        patch.object(UnquantizedLinearMethod, "apply", bf16_apply),
+    ):
+        out = method.apply(layer, x)
+        assert out.shape == (1024, n) and out.dtype == torch.bfloat16
+        assert calls[0] == ("quant", (1024, k), torch.bfloat16, True)
+        assert calls[1] == (
+            "gemm",
+            (1024, k),
+            (k, n),
+            (1024, 1),
+            (1, n),
+            torch.bfloat16,
+            None,
+        )
+
+        # Decode batches, 3D input, fp32 input, and a bias stay on bf16.
+        calls.clear()
+        method.apply(layer, torch.randn(256, k, dtype=torch.bfloat16))
+        method.apply(layer, torch.randn(2, 512, k, dtype=torch.bfloat16))
+        method.apply(layer, x, bias=torch.zeros(n))
+        method.apply(layer, torch.randn(1024, k))
+        assert calls == [
+            ("bf16", 2, 256),
+            ("bf16", 3, 2),
+            ("bf16", 2, 1024),
+            ("bf16", 2, 1024),
+        ]
+
+        # A layer whose cache was never built stays on bf16 at any size.
+        calls.clear()
+        method.apply(_linear(n=n, k=k), x)
+        assert calls == [("bf16", 2, 1024)]
