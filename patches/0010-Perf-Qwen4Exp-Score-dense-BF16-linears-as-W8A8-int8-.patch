@@ -0,0 +1,162 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""W8A8 int8 scoring for the dense linears of Qwen4Exp.
+
+The shipped FP8 checkpoint quantizes only the routed experts: its
+quantization_config lists every dense linear (attention qkv/o, GDN
+projections, shared MLP) in modules_to_not_convert, so those layers load
+their bf16 weights and run the unquantized bf16 GEMM. sm_80 (CMP 170HX)
+int8 tensor cores run at twice the bf16 rate on half the weight bytes, and
+a W8A8 shootout on this box (2026-10-22, results.md) measures CUTLASS int8
+at 1.29-1.68x over the deployed dense bf16 GEMM at M=2048, including the
+per-token activation quant.
+
+Enable with VLLM_QWEN4EXP_DENSE_W8A8=1. `enable_qwen4exp_dense_w8a8` swaps
+the quant method of the eligible layers in place; the method round-quantizes
+the loaded bf16 weight to per-output-channel int8 once after loading, then
+scores with dynamic per-token activation quant plus `cutlass_scaled_mm`.
+Batches below the benched size (decode, and everything CUDA graphs captured)
+keep calling the bf16 GEMM with the untouched weight.
+"""
+
+import re
+
+import torch
+
+from vllm import _custom_ops as ops
+from vllm import envs
+from vllm.logger import init_logger
+from vllm.model_executor.layers.linear import (
+    LinearBase,
+    UnquantizedLinearMethod,
+)
+from vllm.platforms import current_platform
+
+logger = init_logger(__name__)
+
+# int8 pays off only at prefill sizes; below this the deployed path stays
+# in the CUDA-graph capture range, where it must not change.
+_MIN_M = 512
+_MIN_ELEMS = 2_000_000
+_MIN_K = 1024
+# One row block per RTN pass: the fp32 intermediates are 4x the bf16 slice.
+_QUANT_BLOCK_ELEMS = 64 * 1024 * 1024
+
+# Only these GEMMs were benched. Routers (.gate, .shared_expert_gate), the
+# GDN conv1d, the QSA indexer, PLE, embeddings, and the LM head stay out.
+_ELIGIBLE_SUFFIX = re.compile(
+    r"\.(?:qkv_proj|o_proj|in_proj_qkvz|in_proj_ba|out_proj|gate_up_proj|down_proj)$"
+)
+
+
+def quantize_weight_per_channel(
+    weight: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Round-to-nearest a bf16 (N, K) weight to per-output-channel int8.
+
+    Args:
+        weight: Dense weight in the ``(N, K)`` layout it was loaded in.
+
+    Returns:
+        ``(B, scale_b)`` where ``B`` is a ``(K, N)`` column-major int8 view for
+        ``cutlass_scaled_mm`` and ``scale_b`` is the ``(1, N)`` output-channel
+        scale.
+
+    """
+    n, k = weight.shape
+    quantized = torch.empty(n, k, dtype=torch.int8, device=weight.device)
+    scales = torch.empty(n, 1, dtype=torch.float32, device=weight.device)
+    step = max(1, _QUANT_BLOCK_ELEMS // (2 * k))
+    for i in range(0, n, step):
+        block = weight[i : i + step].float()
+        block_scale = block.abs().amax(dim=1, keepdim=True).clamp_min(1e-8) / 127.0
+        quantized[i : i + step] = torch.round(block / block_scale).clamp_(-127, 127)
+        scales[i : i + step] = block_scale
+    return quantized.t(), scales.t().contiguous()
+
+
+class Qwen4ExpDenseW8A8LinearMethod(UnquantizedLinearMethod):
+    """BF16 dense linear that also scores as W8A8 int8 through CUTLASS.
+
+    The bf16 weight is kept exactly as the parent method uses it, so any
+    batch the int8 path declines to serve runs the same GEMM (and the same
+    captured CUDA graph) this deployment uses today.
+    """
+
+    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:
+        super().process_weights_after_loading(layer)
+        weight = getattr(layer, "weight", None)
+        if weight is not None and weight.dtype in (torch.bfloat16, torch.float16):
+            layer._qwen4exp_dense_w8a8 = quantize_weight_per_channel(weight.data)
+
+    def apply(
+        self,
+        layer: torch.nn.Module,
+        x: torch.Tensor,
+        bias: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        cache = getattr(layer, "_qwen4exp_dense_w8a8", None)
+        if (
+            cache is not None
+            and bias is None
+            and x.dim() == 2
+            and x.shape[0] >= _MIN_M
+            and x.dtype in (torch.bfloat16, torch.float16)
+        ):
+            x_q, scale_a, _ = ops.scaled_int8_quant(
+                x.contiguous(), None, None, symmetric=True
+            )
+            return ops.cutlass_scaled_mm(x_q, cache[0], scale_a, cache[1], x.dtype)
+        return super().apply(layer, x, bias)
+
+
+def _is_eligible(layer: torch.nn.Module) -> bool:
+    if not _ELIGIBLE_SUFFIX.search(getattr(layer, "prefix", "") or ""):
+        return False
+    if getattr(layer, "bias", None) is not None:
+        return False
+    n = getattr(layer, "output_size_per_partition", 0)
+    k = getattr(layer, "input_size_per_partition", 0)
+    if n * k < _MIN_ELEMS or k < _MIN_K or (n % 16) or (k % 16):
+        return False
+    weight = getattr(layer, "weight", None)
+    if weight is None or weight.dim() != 2:
+        return False
+    return weight.dtype in (torch.bfloat16, torch.float16)
+
+
+def enable_qwen4exp_dense_w8a8(module: torch.nn.Module) -> None:
+    """Swap the eligible dense linears of a Qwen4Exp module to W8A8 int8."""
+    if not envs.VLLM_QWEN4EXP_DENSE_W8A8:
+        return
+    if envs.VLLM_BATCH_INVARIANT:
+        logger.info("VLLM_QWEN4EXP_DENSE_W8A8 is ignored under batch invariant mode")
+        return
+    # The bench behind these thresholds ran on sm_80, where the dense GEMMs
+    # are bf16 and int8 doubles the tensor-core rate. Elsewhere the bf16
+    # GEMM and the FP8 kernels this deployment does not use are preferred.
+    if not current_platform.is_cuda() or not current_platform.is_device_capability(80):
+        logger.info_once(
+            "VLLM_QWEN4EXP_DENSE_W8A8 is only supported on sm_80, staying on bf16"
+        )
+        return
+
+    swapped = 0
+    for child in module.modules():
+        if not isinstance(child, LinearBase):
+            continue
+        method = child.quant_method
+        # Exact type so a layer already claimed by another Qwen4Exp method
+        # (the draft W8A8 head, low-latency skinny GEMMs) or an embedding
+        # method is left alone.
+        if type(method) is not UnquantizedLinearMethod or not _is_eligible(child):
+            continue
+        # In-place class swap keeps the dispatched bf16 GEMM the fallback
+        # below and the CUDA-graph capture still need.
+        method.__class__ = Qwen4ExpDenseW8A8LinearMethod
+        swapped += 1
+    logger.info(
+        "Dense bf16 linears scored as W8A8 int8 via CUTLASS: %d of %d layers",
+        swapped,
+        sum(isinstance(c, LinearBase) for c in module.modules()),
+    )
