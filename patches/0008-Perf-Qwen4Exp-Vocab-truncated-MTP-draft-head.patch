+logger = init_logger(__name__)
+
+
+def expand_draft_logits(
+    sub_logits: torch.Tensor, draft_vocab_ids: torch.Tensor, vocab_size: int
+) -> torch.Tensor:
+    """Scatter draft-head logits into full-vocabulary space, -inf elsewhere.
+
+    Keeps the compute_logits contract identical, so proposal argmax and any
+    sampler path behave as with the full head; ids outside the draft
+    vocabulary simply can never be proposed.
+    """
+    full = sub_logits.new_full((sub_logits.shape[0], vocab_size), float("-inf"))
+    full.index_copy_(1, draft_vocab_ids.to(sub_logits.device), sub_logits)
+    return full
+
+
 def _remap_mtp_weight_name(name: str) -> str | None:
     """Map Qwen4Exp checkpoint paths into the standalone draft model."""
     for checkpoint_prefix in (
@@ -100,6 +119,8 @@ def _remap_mtp_weight_name(name: str) -> str | None:
         name = f"model.{name}"
     if name.startswith("model.mtp."):
         name = name.removeprefix("model.")
+    if name.startswith("mtp.draft_lm_head."):
+        return name.replace("mtp.draft_lm_head.", "draft_lm_head.", 1)
     if name.startswith("mtp.shared_head.head."):
         return name.replace("mtp.shared_head.head.", "lm_head.", 1)
     if name.startswith("model.shared_head.head."):
@@ -386,8 +407,37 @@ class Qwen4ExpMTP(nn.Module, SupportsPP, Qwen4ExpMixtureOfExperts):
             prefix=maybe_prefix(prefix, "mtp"),
         )
 
+        self.draft_lm_head = None
+        self.draft_logits_processor = None
         if get_pp_group().is_last_rank:
-            if config.tie_word_embeddings:
+            draft_ids_path = os.path.join(
+                str(vllm_config.model_config.model), "mtp_draft_vocab_ids.pt"
+            )
+            if os.path.exists(draft_ids_path):
+                # Vocab-truncated draft head: score only the ids the model
+                # actually produces instead of the full-vocabulary lm_head
+                # once per draft step (build_draft_vocab.py writes both
+                # artifacts). Verification still runs the target head, so
+                # output quality is unchanged; only proposal coverage can
+                # shift acceptance.
+                ids = torch.load(draft_ids_path, map_location="cpu").to(torch.long)
+                if torch.cuda.is_available():
+                    # register_buffer ignores the loader device context, and a
+                    # CPU->GPU copy is illegal inside CUDA graph capture.
+                    ids = ids.to(torch.device(f"cuda:{torch.cuda.current_device()}"))
+                self.register_buffer("draft_vocab_ids", ids, persistent=False)
+                self.draft_lm_head = ParallelLMHead(
