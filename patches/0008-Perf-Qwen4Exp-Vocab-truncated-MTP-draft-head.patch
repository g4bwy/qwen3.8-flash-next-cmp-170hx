+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Draft-vocabulary head wiring for the Qwen4Exp MTP drafter."""
+
+import pytest
+import torch
+
+from vllm.models.qwen4_exp.nvidia.mtp import (
+    _remap_mtp_weight_name,
+    expand_draft_logits,
+)
+
+
+@pytest.mark.cpu_test
+def test_expand_draft_logits_scatters_and_masks() -> None:
+    sub = torch.tensor([[1.0, 2.0], [3.0, 4.0]])
+    ids = torch.tensor([7, 3])
+    out = expand_draft_logits(sub, ids, vocab_size=10)
+    assert out.shape == (2, 10)
+    assert out[0, 7] == 1.0 and out[0, 3] == 2.0
+    assert out[1, 7] == 3.0 and out[1, 3] == 4.0
+    masked = out[:, [0, 1, 2, 4, 5, 6, 8, 9]]
+    assert torch.isinf(masked).all() and (masked < 0).all()
+
+
+@pytest.mark.cpu_test
+def test_draft_head_weight_names_remap() -> None:
+    assert _remap_mtp_weight_name("mtp.draft_lm_head.weight") == "draft_lm_head.weight"
+    assert _remap_mtp_weight_name("mtp.shared_head.head.weight") == "lm_head.weight"
