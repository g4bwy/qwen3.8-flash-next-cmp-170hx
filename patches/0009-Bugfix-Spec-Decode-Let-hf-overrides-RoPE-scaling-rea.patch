+@pytest.mark.cpu_test
+def test_qwen4_exp_wrapper_standardizes_scaled_rope() -> None:
+    """The wrapper aliases the text config's rope_parameters, so transformers'
+    RoPE standardization treats the wrapper as a RoPE-bearing config and reads
+    the trained window off it as soon as that dict declares a scaling type.
+    Static YaRN arriving through --hf-overrides is enough to trip it."""
+    from vllm.transformers_utils.config import patch_rope_parameters
+
+    text_config = _text_config(
+        rope_parameters={
+            "mrope_interleaved": True,
+            "mrope_section": [1, 1, 2],
+            "rope_theta": 10000,
+            "rope_type": "default",
+        }
+    )
+    config = Qwen4ExpConfig(text_config=text_config)
+    # What --hf-overrides does to the shared dict before the config is used.
+    text_config.rope_parameters.update(
+        {"rope_type": "yarn", "factor": 2.0, "original_max_position_embeddings": 1024}
+    )
+
+    patch_rope_parameters(config)
+
+    assert text_config.rope_parameters["rope_type"] == "yarn"
+    assert text_config.rope_parameters["mrope_section"] == [1, 1, 2]
+    assert text_config.rope_parameters["original_max_position_embeddings"] == 1024
