+    )
+    config = _make_hf_config(text_config=text_config)
+    out = composed(config)
+
+    assert out is config
+    # The nested dict is merged, not replaced, so unrelated keys survive.
+    assert text_config.rope_parameters == {
+        "mrope_section": [11, 11, 10],
