+def _draft_hf_overrides_kwarg(
+    draft_model: str,
+    target_model: str,
+    target_hf_overrides: dict,
+) -> object:
+    """Build an mtp SpeculativeConfig and return the ``hf_overrides`` that was
+    handed to the draft ``ModelConfig``. Guards the call-site gate, which the
+    direct ``compose_draft_hf_overrides`` tests cannot reach."""
+    captured: dict = {}
+
+    def fake_model_config(**kwargs) -> MagicMock:
+        captured.update(kwargs)
+        hf_config = _make_hf_config(
+            architectures=["Qwen4ExpMTP"], model_type="qwen4_exp_mtp", n_predict=1
+        )
+        return MagicMock(
+            model=draft_model,
+            hf_config=hf_config,
+            architectures=hf_config.architectures,
+            max_model_len=128,
+        )
+
+    target_model_config = MagicMock(
+        model=target_model,
+        model_weights=None,
+        max_model_len=128,
+        quantization=None,
+        hf_overrides=target_hf_overrides,
+    )
+    with patch("vllm.config.speculative.ModelConfig", side_effect=fake_model_config):
+        SpeculativeConfig(
+            model=draft_model,
+            method="mtp",
+            num_speculative_tokens=1,
+            target_model_config=target_model_config,
+            target_parallel_config=ParallelConfig(),
+        )
+    return captured["hf_overrides"]
+
+
+@pytest.mark.cpu_test
+def test_same_checkpoint_draft_is_handed_the_target_dict_overrides():
+    rope = {"text_config": {"rope_parameters": {"rope_type": "yarn", "factor": 2.0}}}
+    composed = _draft_hf_overrides_kwarg("ckpt", "ckpt", rope)
+    assert isinstance(composed, functools.partial)
+
+    text_config = _make_hf_config(rope_parameters={"mrope_section": [11, 11, 10]})
+    composed(_make_hf_config(text_config=text_config))
+    assert text_config.rope_parameters["rope_type"] == "yarn"
+    assert text_config.rope_parameters["mrope_section"] == [11, 11, 10]
+
+
+@pytest.mark.cpu_test
+def test_foreign_draft_is_not_handed_the_target_dict_overrides():
+    rope = {"text_config": {"rope_parameters": {"rope_type": "yarn"}}}
+    composed = _draft_hf_overrides_kwarg("other-ckpt", "ckpt", rope)
+    assert composed is SpeculativeConfig.hf_config_override
