--- a/vllm/platforms/interface.py
+++ b/vllm/platforms/interface.py
@@ -965,6 +965,49 @@ class Platform:
         if cache_config.mamba_page_size_padded is not None:
             cache_config.mamba_page_size_padded = shared_page
 
+    @classmethod
+    def get_mamba_checkpoint_grid(
+        cls, vllm_config: "VllmConfig", layer_grid: int | None
+    ) -> int | None:
+        """Checkpoint grid the Mamba layers may impose on the KV block size.
+
+        The hybrid alignment LCMs this grid into the block size, so a grid that
+        does not divide the block grows the block. With
+        `VLLM_MAMBA_CHECKPOINT_BLOCK_PIN=1` the block keeps its page-driven
+        size and the grid is declined: returning None turns off internal
+        prefill checkpoints, so the scheduler resumes splitting prefills, as it
+        did before the layers exported them. Override this method to pick a
+        different policy for a platform.
+
+        Args:
+            vllm_config: Config being resolved; reads `cache_config`.
+            layer_grid: LCM of the Mamba layers' declared checkpoint alignments,
+                or None when a layer exports no checkpoints.
+
+        Returns:
+            The grid to align blocks to, or None for no internal checkpoints.
+
+        """
+        from vllm import envs
+
+        if layer_grid is None:
