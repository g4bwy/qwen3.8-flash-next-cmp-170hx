index a5c8d6f4cf..582d09e023 100644
--- a/vllm/v1/worker/gpu/model_states/interface.py
+++ b/vllm/v1/worker/gpu/model_states/interface.py
@@ -147,6 +147,13 @@ class ModelState(ABC):
         across block boundaries. No-op by default."""
         return None
 
+    def set_req_block_tables(self, req_block_tables: tuple[torch.Tensor, ...]) -> None:
+        """Hand over the persistent block tables indexed by request state slot
+        (row = request index) instead of batch row. No-op by default; needed by
+        state copies that can run after the step which scheduled the request has
+        re-gathered the batch-ordered tables."""
+        return None
+
     def postprocess_state(
         self,
         idx_mapping: torch.Tensor,
diff --git a/vllm/v1/worker/gpu/model_states/mamba_hybrid.py b/vllm/v1/worker/gpu/model_states/mamba_hybrid.py
