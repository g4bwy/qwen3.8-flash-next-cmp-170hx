             self._mamba_state_copy_funcs: MambaStateCopyFuncsByType | None = None
+            self._req_block_tables: tuple[torch.Tensor, ...] | None = None
+
+    def set_req_block_tables(self, req_block_tables: tuple[torch.Tensor, ...]) -> None:
+        # The state copies of the align path must resolve block ids by request
+        # state slot; see MambaSpecDecodeGPUContext.copy_block_table_ptrs.
+        self._req_block_tables = req_block_tables
 
     def add_request(self, req_index: int, new_req_data: NewRequestData) -> None:
         super().add_request(req_index, new_req_data)
@@ -171,12 +177,18 @@ class MambaHybridModelState(DefaultModelState):
             forward_context = self.vllm_config.compilation_config.static_forward_context
             # block_tables are batch-order slices of the persistent
             # input_block_tables (stable data_ptr), so the metadata is captured
-            # once here and reused across steps.
+            # once here and reused across steps. The state copies are captured
+            # from the request-indexed tables instead: a copy issued by a later
+            # step would otherwise walk another request's block ids.
+            req_block_tables = self._req_block_tables
             ctx.initialize_from_forward_context(
                 kv_cache_config,
                 forward_context,
                 copy_funcs,
                 [block_tables[gid] for gid in mamba_group_ids],
+                None
+                if req_block_tables is None
+                else [req_block_tables[gid] for gid in mamba_group_ids],
             )
         return ctx
 
