 vllm/v1/worker/gpu/model_runner.py            |  4 ++
 vllm/v1/worker/gpu/model_states/interface.py  |  7 +++
 .../worker/gpu/model_states/mamba_hybrid.py   | 14 +++++-
 vllm/v1/worker/mamba_utils.py                 | 49 ++++++++++++++++---
 5 files changed, 77 insertions(+), 8 deletions(-)

diff --git a/vllm/v1/worker/gpu/block_table.py b/vllm/v1/worker/gpu/block_table.py
index c01895e635..dcc9ac1c82 100644
--- a/vllm/v1/worker/gpu/block_table.py
+++ b/vllm/v1/worker/gpu/block_table.py
@@ -110,6 +110,17 @@ class BlockTables:
         )
         self.input_block_table_ptrs = self._make_ptr_tensor(self.input_block_tables)
 
+    @property
+    def req_block_tables(self) -> tuple[torch.Tensor, ...]:
+        """Block tables whose rows are request state slots, not batch rows.
+
+        These are the tables the scheduler stages into, so a row only grows
+        while its request lives. Consumers that outlive the step which gathered
+        ``input_block_tables`` (mamba state copies deferred under pipeline
+        parallelism) resolve block ids here instead of by batch row.
+        """
+        return tuple(b.gpu for b in self.block_tables)
+
     def append_block_ids(
         self,
         req_index: int,
diff --git a/vllm/v1/worker/gpu/model_runner.py b/vllm/v1/worker/gpu/model_runner.py
index 97571df8a9..c2b6802b56 100644
--- a/vllm/v1/worker/gpu/model_runner.py
+++ b/vllm/v1/worker/gpu/model_runner.py
@@ -663,6 +663,10 @@ class GPUModelRunner(LoRAModelRunnerMixin):
             cp_rank=self.dcp_rank,
             cp_interleave=self.cp_interleave,
         )
+        # Mamba state copies can be issued by a later step than the one which
+        # scheduled the request, so they resolve block ids by request state
+        # slot rather than by the batch rows of the current gather.
+        self.model_state.set_req_block_tables(self.block_tables.req_block_tables)
         self.pcp_manager = pcp.maybe_build_pcp_manager(
             self.vllm_config,
             self.device,
