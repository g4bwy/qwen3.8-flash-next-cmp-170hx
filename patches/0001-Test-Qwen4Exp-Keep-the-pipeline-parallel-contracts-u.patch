+@pytest.mark.parametrize("ple_layer_ids", [[1], []])
+def test_qwen4_exp_allows_pipeline_parallel_with_or_without_ple(
+    ple_layer_ids,
+) -> None:
+    """Qwen4Exp PP supports both the PLE and non-PLE configurations."""
+    vllm_config = SimpleNamespace(
