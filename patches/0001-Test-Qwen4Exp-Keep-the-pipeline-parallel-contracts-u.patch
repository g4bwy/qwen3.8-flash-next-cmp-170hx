+@spawn_new_process_for_each_test
+@pytest.mark.parametrize("backend", ["amd", "nvidia"])
+def test_qwen4_exp_pp_intermediate_tensors_never_carry_input_ids(
+    backend: str,
+) -> None:
+    """PLE token IDs ride the stage-local #61016 flow, never the PP wire."""
+    model_module = import_module(f"vllm.models.qwen4_exp.{backend}.model")
+    model = object.__new__(model_module.Qwen4ExpModel)
+    torch.nn.Module.__init__(model)
+
+    for config in (_text_config(), _text_config(ple_layer_ids=[])):
+        model.config = config
+        if not hasattr(model_module.Qwen4ExpModel, "make_empty_intermediate_tensors"):
+            # Upstream wiring: the factory is bound per instance in __init__.
+            model.make_empty_intermediate_tensors = (
+                make_empty_intermediate_tensors_factory(
+                    ["hidden_states"], config.hidden_size * config.hc_count
+                )
+            )
+        tensors = model.make_empty_intermediate_tensors(
+            batch_size=8,
+            dtype=torch.bfloat16,
+            device=torch.device("cpu"),
+        )
+        assert set(tensors.tensors) == {"hidden_states"}
+
+
+@spawn_new_process_for_each_test
+@pytest.mark.parametrize("backend", ["amd", "nvidia"])
+def test_qwen4_exp_pp_forward_uses_runner_input_ids(backend: str) -> None:
+    """Non-first PP ranks feed the stage-local input IDs to decoder layers."""
+    model_module = import_module(f"vllm.models.qwen4_exp.{backend}.model")
+    model = object.__new__(model_module.Qwen4ExpModel)
+    torch.nn.Module.__init__(model)
+    model.config = _text_config()
+    model.start_layer = 0
+    model.end_layer = 1
+    model.hyper_connection_mixer = None
+
+    seen_input_ids: list[torch.Tensor | None] = []
+
+    class CaptureLayer:
+        def __call__(self, **kwargs):
+            seen_input_ids.append(kwargs["input_ids"])
+            return kwargs["hidden_states"], None, None
+
+    model.layers = [CaptureLayer()]
+    input_ids = torch.tensor([11, 13], dtype=torch.int32)
+    intermediate_tensors = IntermediateTensors({"hidden_states": torch.zeros(2, 32)})
+    pp_group = SimpleNamespace(is_first_rank=False, is_last_rank=False)
+
+    with patch.object(model_module, "get_pp_group", return_value=pp_group):
+        output = model.forward(
+            input_ids=input_ids,
+            positions=torch.arange(2),
+            intermediate_tensors=intermediate_tensors,
+        )
+
+    assert len(seen_input_ids) == 1
+    assert seen_input_ids[0] is input_ids
+    assert isinstance(output, IntermediateTensors)
+    assert set(output.tensors) == {"hidden_states"}
+
+
