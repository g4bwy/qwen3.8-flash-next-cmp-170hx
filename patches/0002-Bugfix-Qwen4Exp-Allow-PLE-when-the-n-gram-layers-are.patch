-                "not receive the raw input_ids required by PLE. Please run "
-                "with PP=1."
+                "N-gram PLE embedding requires pipeline_parallel_size=1 unless "
+                "every PLE layer sits on the first pipeline rank, because only "
+                "that rank receives the raw input_ids PLE needs. Pin the split "
+                "with VLLM_PP_LAYER_PARTITION so that the PLE layers land on "
+                "the first pipeline rank."
             )
 
         self.ngram_context_len = int(config.ngram_size) - 1
