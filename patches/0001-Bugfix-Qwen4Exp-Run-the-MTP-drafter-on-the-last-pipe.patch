From b80ff4099eecd254b6f1594d6675204d7331e7a7 Mon Sep 17 00:00:00 2001
From: Gabriel FORTE <gab@chx-labs.org>
Date: Thu, 10 Sep 2026 11:51:58 +0200
Subject: [PATCH 1/9] [Bugfix][Qwen4Exp] Run the MTP drafter on the last
 pipeline rank

The drafter is instantiated only on the last pipeline rank (model_runner
builds the speculator behind is_last_pp_rank) and is handed the target's
hidden states directly; it is never fed IntermediateTensors. Its forward
keyed the embedding branch on get_pp_group().is_first_rank, so under PP>1
the last rank took the pipeline branch and asserted on intermediate
tensors that never arrive.
---
 tests/models/qwen4_exp/test_config.py | 13 ++++++++++---
 vllm/models/qwen4_exp/nvidia/mtp.py   |  6 +++++-
 2 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/tests/models/qwen4_exp/test_config.py b/tests/models/qwen4_exp/test_config.py
index 9d30365b81..f0cca639bb 100644
--- a/tests/models/qwen4_exp/test_config.py
+++ b/tests/models/qwen4_exp/test_config.py
@@ -72,6 +72,11 @@ def test_qwen4_exp_mtp_returns_sample_and_multi_streams() -> None:
             None,
         ),
     )
+    model.embed_tokens = lambda input_ids: torch.zeros(input_ids.shape[0], 4)
+    model.pre_fc_norm_embedding = lambda hidden_states: hidden_states
+    model.fc_embedding = lambda hidden_states: hidden_states
+    model.pre_fc_norm_hidden = lambda hidden_states: hidden_states
+    model.fc_hidden = lambda hidden_states: hidden_states
     multi_hidden = torch.arange(16, dtype=torch.float32).reshape(2, 8)
     pp_group = SimpleNamespace(is_first_rank=False, is_last_rank=True)
 
@@ -79,17 +84,19 @@ def test_qwen4_exp_mtp_returns_sample_and_multi_streams() -> None:
         "vllm.models.qwen4_exp.nvidia.mtp.get_pp_group",
         return_value=pp_group,
     ):
+        # As the speculator drives it on the rank the drafter lives on: the
+        # target's hidden states and the tokens to append, both local there.
         sample_hidden, returned_multi_hidden = model.forward(
-            input_ids=None,
+            input_ids=torch.arange(2),
             positions=torch.arange(2),
-            intermediate_tensors={"hidden_states": multi_hidden},
+            hidden_states=multi_hidden,
         )
 
     torch.testing.assert_close(
         sample_hidden,
         multi_hidden.unflatten(-1, (2, 4)).mean(dim=-2),
     )
-    assert returned_multi_hidden is multi_hidden
+    torch.testing.assert_close(returned_multi_hidden, multi_hidden)
 
 
 @spawn_new_process_for_each_test
diff --git a/vllm/models/qwen4_exp/nvidia/mtp.py b/vllm/models/qwen4_exp/nvidia/mtp.py
index af3bcd4659..e31905c942 100644
--- a/vllm/models/qwen4_exp/nvidia/mtp.py
+++ b/vllm/models/qwen4_exp/nvidia/mtp.py
@@ -286,7 +286,11 @@ class Qwen4ExpMultiTokenPredictor(nn.Module):
         hidden_size = self.hidden_size
         prev_block_output: torch.Tensor | None = None
 
-        if get_pp_group().is_first_rank:
+        # The drafter is instantiated on the last pipeline rank only and is
+        # handed the target's hidden states directly; it is never fed
+        # IntermediateTensors, so the embedding branch applies there too.
+        pp_group = get_pp_group()
+        if pp_group.is_first_rank or pp_group.is_last_rank:
             assert hidden_states is not None
             if inputs_embeds is None:
                 assert input_ids is not None
