From 70dd5a8f8ef36941305eca2c6300f164e8ac050d Mon Sep 17 00:00:00 2001
From: Gabriel FORTE <2580288+g4bwy@users.noreply.github.com>
Date: Thu, 10 Sep 2026 11:51:58 +0200
Subject: [PATCH 1/8] [Bugfix][Qwen4Exp] Run the MTP drafter on the last
 pipeline rank

The drafter is instantiated only on the last pipeline rank (model_runner
builds the speculator behind is_last_pp_rank) and is handed the target's
hidden states directly; it is never fed IntermediateTensors. Its forward
keyed the embedding branch on get_pp_group().is_first_rank, so under PP>1
the last rank took the pipeline branch and asserted on intermediate
tensors that never arrive.
---
 tests/models/qwen4_exp/test_config.py | 54 +++++++++++++++++++++++++++
 vllm/models/qwen4_exp/nvidia/mtp.py   |  6 ++-
 2 files changed, 59 insertions(+), 1 deletion(-)

diff --git a/tests/models/qwen4_exp/test_config.py b/tests/models/qwen4_exp/test_config.py
index 177ebaf3f6..4ccd437176 100644
--- a/tests/models/qwen4_exp/test_config.py
+++ b/tests/models/qwen4_exp/test_config.py
@@ -135,6 +135,60 @@ def test_qwen4_exp_mtp_returns_sample_and_multi_streams(
     assert returned_multi_hidden.is_contiguous()
 
 
+def test_qwen4_exp_mtp_drafts_on_last_pipeline_rank() -> None:
+    """On a non-first last rank the drafter embeds from input ids directly.
+
+    This is how the speculator drives it after patch 1: the target's hidden
+    states and the tokens to append are both local there, and no
+    IntermediateTensors are fed.
+    """
+    from vllm.models.qwen4_exp.nvidia.mtp import (
+        Qwen4ExpMultiTokenPredictor,
+    )
+
+    model = object.__new__(Qwen4ExpMultiTokenPredictor)
+    model.use_hc_sequence_parallel = False
+    model.use_sequence_parallel = False
+    torch.nn.Module.__init__(model)
+    model.hc_count = 2
+    model.hidden_size = 4
+    model.num_mtp_layers = 1
+    model.pre_fc_norm_embedding = torch.nn.Identity()
+    model.pre_fc_norm_hidden = torch.nn.Identity()
+    model.fc_embedding = torch.nn.Identity()
+    model.fc_hidden = torch.nn.Identity()
+    model.embed_tokens = lambda input_ids: torch.zeros(input_ids.shape[0], 4)
+
+    def decoder(**kwargs):
+        hidden = kwargs["hidden_states"]
+        assert kwargs["prev_block_output"].shape == (hidden.shape[0], model.hidden_size)
+        return hidden, hidden, torch.zeros(hidden.shape[0], model.hc_count)
+
+    model.layers = [decoder]
+    model.hyper_connection_mixer = SimpleNamespace(
+        combine_and_mix=lambda hidden_states, block_output, injection: (
+            hidden_states,
+            hidden_states.unflatten(-1, (2, 4)).mean(-2),
+            None,
+        ),
+    )
+
+    multi_hidden = torch.arange(16, dtype=torch.float32).reshape(2, 8)
+    pp_group = SimpleNamespace(is_first_rank=False, is_last_rank=True)
+
+    with patch("vllm.models.qwen4_exp.nvidia.mtp.get_pp_group", return_value=pp_group):
+        sample_hidden, returned_multi_hidden = model.forward(
+            input_ids=torch.arange(2),
+            positions=torch.arange(2),
+            hidden_states=multi_hidden,
+        )
+
+    torch.testing.assert_close(
+        sample_hidden, multi_hidden.unflatten(-1, (2, 4)).mean(dim=-2)
+    )
+    torch.testing.assert_close(returned_multi_hidden, multi_hidden)
+
+
 @spawn_new_process_for_each_test
 @pytest.mark.parametrize("backend", ["amd", "nvidia"])
 def test_qwen4_exp_mtp_remaps_mixed_precision_layer_indices(backend: str) -> None:
diff --git a/vllm/models/qwen4_exp/nvidia/mtp.py b/vllm/models/qwen4_exp/nvidia/mtp.py
index e9aa87659a..64b2dfd8c4 100644
--- a/vllm/models/qwen4_exp/nvidia/mtp.py
+++ b/vllm/models/qwen4_exp/nvidia/mtp.py
@@ -297,7 +297,11 @@ class Qwen4ExpMultiTokenPredictor(nn.Module):
         hidden_size = self.hidden_size
         prev_block_output: torch.Tensor | None = None
 
-        if get_pp_group().is_first_rank:
+        # The drafter is instantiated on the last pipeline rank only and is
+        # handed the target's hidden states directly; it is never fed
+        # IntermediateTensors, so the embedding branch applies there too.
+        pp_group = get_pp_group()
+        if pp_group.is_first_rank or pp_group.is_last_rank:
             assert hidden_states is not None
             if inputs_embeds is None:
                 assert input_ids is not None
