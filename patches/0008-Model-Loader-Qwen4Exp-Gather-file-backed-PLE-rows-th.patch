 import mmap
 import os
+import warnings
 from collections.abc import Iterable
 
 import torch
@@ -58,6 +59,24 @@ def _maps_entry(ptr: int) -> tuple[str, int]:
     return "", 0
 
 
+_MAPPED_FILES: dict[str, tuple[mmap.mmap, torch.Tensor]] = {}
+
+
+def _mapped_file_bytes(path: str) -> torch.Tensor:
+    """Return a read-only uint8 tensor over ``path``, mapped once per file."""
+    hit = _MAPPED_FILES.get(path)
+    if hit is not None:
+        return hit[1]
+    with open(path, "rb") as handle:
+        mapping = mmap.mmap(handle.fileno(), 0, access=mmap.ACCESS_READ)
+    with warnings.catch_warnings():
+        # A mapped checkpoint is intentionally immutable and read-only.
+        warnings.simplefilter("ignore", UserWarning)
+        data = torch.frombuffer(mapping, dtype=torch.uint8)
+    _MAPPED_FILES[path] = (mapping, data)
+    return data
+
+
