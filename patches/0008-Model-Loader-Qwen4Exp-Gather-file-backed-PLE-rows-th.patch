+def test_file_gather_mmap_serves_the_same_rows_as_preadv(monkeypatch, tmp_path) -> None:
+    """The mapped gather is byte-identical to preadv, covering duplicates and
+    the trailing partial shard, after the loader's views were released."""
+    preadv, table = _make_file_gather_embedding(monkeypatch, tmp_path, bind=True)
+    mapped, _ = _make_file_gather_embedding(
+        monkeypatch, tmp_path, bind=True, use_mmap=True
+    )
+    embedding = mapped.ngram_embedding
+    assert embedding._shards == {}
+    row_bytes = embedding._rows.shape[1]
+    assert torch.equal(embedding._tables[0][0], table[0].view(torch.uint8)[:row_bytes])
+
+    generator = torch.Generator().manual_seed(3)
+    ids = torch.randint(0, 21, (12, 2), generator=generator)
+    ids[0, 0] = 20  # last row of the trailing partial shard
+    ids[1, 1] = ids[0, 0]  # duplicate expansion through the inverse
+    for module in (preadv, mapped):
+        module.ngram_embedding._host_ids.copy_(ids)
+        module.ngram_embedding.stage_rows(12)
+
+    assert torch.equal(
+        mapped.ngram_embedding._staging.view(torch.uint8),
+        preadv.ngram_embedding._staging.view(torch.uint8),
+    )
+
+
