+def _pp_hop_quantize(
+    hidden: torch.Tensor, hc_count: int
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Per-token, per-stream symmetric int8 for the PP handoff.
+
+    Rows hold hc streams concatenated ([s0|s1|s2|s3]); each stream is scaled
+    independently so one outlier stream cannot flatten the others.
+    """
+    streams = hidden.reshape(hidden.shape[0], hc_count, -1)
+    scale = streams.abs().amax(dim=-1).clamp_(min=1e-6).mul_(1.0 / 127.0).float()
+    q = (streams / scale.unsqueeze(-1)).round_().clamp_(-127.0, 127.0)
+    return q.to(torch.int8).reshape(hidden.shape), scale
+
+
+def _pp_hop_dequantize(
+    q: torch.Tensor, scale: torch.Tensor, dtype: torch.dtype
+) -> torch.Tensor:
+    streams = q.reshape(q.shape[0], scale.shape[1], -1).to(
+        torch.float32
+    ) * scale.unsqueeze(-1)
+    return streams.reshape(q.shape[0], -1).to(dtype)
+
+
