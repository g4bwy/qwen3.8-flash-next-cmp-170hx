From 0774095d8263cef405c26ce399fa6f991ba745d3 Mon Sep 17 00:00:00 2001
From: Gabriel FORTE <2580288+g4bwy@users.noreply.github.com>
Date: Fri, 9 Oct 2026 20:51:39 +0200
Subject: [PATCH 05/11] [Model Loader] Qwen4Exp: Honor fp8 PLE tables under
 compressed-tensors

The compressed-tensors branch of Qwen4ExpPLEEmbeddingMethod
.from_quant_config only handled "no scheme -> unquantized" and let
anything else fall through to the Fp8Config-only gate, so an fp8 PLE
n-gram table in a compressed-tensors checkpoint failed to load with
"no parameter named ngram_embedding.weight_scale".

Resolve the scheme: unquantized when the prefix has no scheme, fp8
when it targets float8 weights. Anything else in that group falls
through to the warn-and-unquantize tail, matching upstream's
test_ple_embedding_falls_back_for_unsupported_quantization_configs.
---
 vllm/models/qwen4_exp/common/ngram_embedding.py | 16 +++++++++++-----
 1 file changed, 11 insertions(+), 5 deletions(-)

diff --git a/vllm/models/qwen4_exp/common/ngram_embedding.py b/vllm/models/qwen4_exp/common/ngram_embedding.py
index d5bd9f6892..de651c92e1 100644
--- a/vllm/models/qwen4_exp/common/ngram_embedding.py
+++ b/vllm/models/qwen4_exp/common/ngram_embedding.py
@@ -209,11 +209,17 @@ class Qwen4ExpPLEEmbeddingMethod(QuantizeMethodBase):
                         f"{prefix!r}; expected FP8 or NVFP4"
                     )
                 return Qwen4ExpPLEUnquantizedEmbeddingMethod()
-        if (
-            isinstance(quant_config, CompressedTensorsConfig)
-            and quant_config.get_scheme_dict(None, layer_name=prefix) is None
-        ):
-            return Qwen4ExpPLEUnquantizedEmbeddingMethod()
+        if isinstance(quant_config, CompressedTensorsConfig):
+            scheme = quant_config.get_scheme_dict(None, layer_name=prefix)
+            if scheme is None:
+                return Qwen4ExpPLEUnquantizedEmbeddingMethod()
+            weights = scheme.get("weights")
+            if (
+                weights is not None
+                and weights.type == "float"
+                and weights.num_bits == 8
+            ):
+                return Qwen4ExpPLEFp8EmbeddingMethod()
         if (
             isinstance(quant_config, INCConfig)
             and not quant_config.config_parser.resolve(None, prefix).quantized
